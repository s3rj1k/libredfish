+#!/usr/bin/env bash
+# Runs nico-admin-cli inside the nico-api pod with the pod's SPIFFE identity over
+# mTLS on the lab k0s in nico-system. Pass any admin-cli args, for example
+#   lab/scripts/admin-cli.sh machine show
+#   lab/scripts/admin-cli.sh machine show -f json
+# The repo's dev/bin/admin-cli.sh targets the old minikube/forge-system layout,
+# not this k0s lab, so use this wrapper instead.
+set -euo pipefail
+
+NS="${NICO_NS:-nico-system}"
+API_PORT="${API_PORT:-1079}"
+
+exec kubectl -n "$NS" exec -i deploy/nico-api -- env \
+  API_URL="https://nico-api.${NS}.svc.cluster.local:${API_PORT}" \
+  ROOT_CA_PATH=/var/run/secrets/forge-roots/ca.crt \
+  CLIENT_CERT_PATH=/var/run/secrets/spiffe.io/tls.crt \
+  CLIENT_KEY_PATH=/var/run/secrets/spiffe.io/tls.key \
+  /opt/carbide/nico-admin-cli "$@"
diff --git a/lab/scripts/env.sh b/lab/scripts/env.sh
new file mode 100755
index 000000000..7c29e35e7
--- /dev/null
+++ b/lab/scripts/env.sh
@@ -0,0 +1,93 @@
+#!/usr/bin/env bash
+# Writes a static lab.env from lab defaults plus the live sushy BMC password and
+# chassis serial. Anything it cannot derive is left empty and reported, to be
+# filled in by hand, so lab.env is always written. Rerun after a worker reprovision.
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+OUT="${LAB_ENV:-${HERE}/lab.env}"
+
+# Static defaults (override by exporting before running).
+REGISTRY="${REGISTRY:-oci.s3rj1k.fyi}"
+# Subfolder the build publishes under so images are not at the registry root.
+IMAGE_NAMESPACE="${IMAGE_NAMESPACE:-nv}"
+KUBECONFIG="${KUBECONFIG:-${HOME}/.kube/config}"
+
+# Image tag from the rune commit (matches build playbook nico_tag_ref) so it stays
+# stable across WiP lab commit amends. Override with CORE_TAG or TAG_REF.
+TAG_REF="${TAG_REF:-HEAD~1}"
+if [[ -z "${CORE_TAG:-}" ]]; then
+  _epoch="$(git -C "$HERE" show -s --format=%ct "$TAG_REF")"
+  _hash="$(git -C "$HERE" rev-parse --short "$TAG_REF")"
+  CORE_TAG="v${_epoch}-${_hash}"
+fi
+# REST images share the Core build tag (one IMAGE_TAG for the whole build).
+NICO_REST_IMAGE_TAG="${NICO_REST_IMAGE_TAG:-$CORE_TAG}"
+
+HOST_IP="${HOST_IP:-192.168.42.221}"
+BMH_NAME="${BMH_NAME:-node1}"
+BOOT_MAC="${BOOT_MAC:-52:54:00:12:34:01}"
+
+BMC_MAC="${BMC_MAC:-02:00:00:00:00:01}"
+BMC_IP="${BMC_IP:-10.42.71.103}"
+BMC_PORT="${BMC_PORT:-8000}"
+# Redfish System name that sushy maps to the domain UUID
+BMC_REDFISH_ID="${BMC_REDFISH_ID:-node1}"
+BMC_USERNAME="${BMC_USERNAME:-admin}"
+
+# Live sushy password at /root/.redfish_password owned by root, so ssh as the
+# login user (BMC_SSH_USER) and sudo. Lab hosts recycle so skip host key checks.
+BMC_SSH_USER="${BMC_SSH_USER:-$(id -un)}"
+BMC_SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null)
+BMC_PASSWORD="${BMC_PASSWORD:-$(ssh "${BMC_SSH_OPTS[@]}" "${BMC_SSH_USER}@${BMC_IP}" sudo cat /root/.redfish_password 2>/dev/null || true)}"
+# Stock sushy keys the System by libvirt UUID not the node name, so discover the
+# ComputerSystem id from the collection. Serial must match what NICo computes.
+SYSTEM_PATH="${SYSTEM_PATH:-$(curl -skL -u "${BMC_USERNAME}:${BMC_PASSWORD}" \
+    "https://${BMC_IP}:${BMC_PORT}/redfish/v1/Systems" 2>/dev/null \
+    | python3 -c 'import sys,json; m=json.load(sys.stdin).get("Members") or []; print(m[0]["@odata.id"] if m else "")' 2>/dev/null || true)}"
+
+# Stock sushy leaves SerialNumber blank so synthesize from the UUID (hyphens
+# stripped and uppercased), the same derivation the nico-api sushy-rune uses.
+SERIAL="${SERIAL:-$(curl -skL -u "${BMC_USERNAME}:${BMC_PASSWORD}" \
+    "https://${BMC_IP}:${BMC_PORT}${SYSTEM_PATH}" 2>/dev/null \
+    | python3 -c 'import sys,json; d=json.load(sys.stdin); sn=(d.get("SerialNumber") or "").strip(); print(sn if sn else d["UUID"].replace("-","").upper())' 2>/dev/null || true)}"
+
+# lab.env holds BMC_PASSWORD, so keep it private (0600) and never commit it.
+umask 077
+{
+  echo "# Generated by env.sh. Rerun to refresh."
+  printf 'export KUBECONFIG=%q\n'           "$KUBECONFIG"
+  printf 'export REGISTRY=%q\n'             "$REGISTRY"
+  printf 'export NICO_IMAGE_REGISTRY=%q\n'  "${REGISTRY}/${IMAGE_NAMESPACE}"
+  printf 'export NICO_CORE_IMAGE_TAG=%q\n'  "$CORE_TAG"
+  printf 'export NICO_REST_IMAGE_TAG=%q\n'  "$NICO_REST_IMAGE_TAG"
+  printf 'HOST_IP=%q\n'                     "$HOST_IP"
+  printf 'BMH_NAME=%q\n'                    "$BMH_NAME"
+  printf 'BOOT_MAC=%q\n'                    "$BOOT_MAC"
+  printf 'BMC_MAC=%q\n'                     "$BMC_MAC"
+  printf 'BMC_IP=%q\n'                      "$BMC_IP"
+  printf 'BMC_PORT=%q\n'                    "$BMC_PORT"
+  printf 'BMC_REDFISH_ID=%q\n'              "$BMC_REDFISH_ID"
+  printf 'BMC_USERNAME=%q\n'                "$BMC_USERNAME"
+  printf 'BMC_PASSWORD=%q\n'                "$BMC_PASSWORD"
+  printf 'SERIAL=%q\n'                      "$SERIAL"
+} > "$OUT"
+
+echo "wrote ${OUT}"
+
+# Probing is best effort because the sushy host may be down or recycled. Report
+# what is missing instead of dying, so the rest of lab.env is still usable.
+BLANKS=()
+[[ -n "$BMC_PASSWORD" ]] || BLANKS+=("BMC_PASSWORD")
+[[ -n "$SERIAL" ]] || BLANKS+=("SERIAL")
+[[ ${#BLANKS[@]} -eq 0 ]] || echo "NOTE: ${BLANKS[*]} left blank, fill in by hand (see lab/hints.md)."
+
+# Expose the exported vars through direnv by sourcing lab.env from the gitignored
+# .local_envrc that .envrc already loads. Idempotent, run direnv reload after.
+REPO_ROOT="$(git -C "${HERE}" rev-parse --show-toplevel)"
+SRC_LINE="source ${OUT}"
+if ! grep -qxF "${SRC_LINE}" "${REPO_ROOT}/.local_envrc" 2>/dev/null; then
+  printf '%s\n' "${SRC_LINE}" >> "${REPO_ROOT}/.local_envrc"
+  echo "wired ${OUT} into ${REPO_ROOT}/.local_envrc"
+fi
+echo "run 'direnv reload' to expose the vars in this shell"
diff --git a/lab/scripts/provision-instance.md b/lab/scripts/provision-instance.md
new file mode 100644
index 000000000..8f37a084e
--- /dev/null
+++ b/lab/scripts/provision-instance.md
@@ -0,0 +1,107 @@
+# provision-instance.sh
+
+Provisions a dpuless machine. Registers the OS image, reuses or allocates an
+instance on the flat VPC, then reboots with custom PXE to image the disk.
+
+Rerunning reimages, it does not release or reenroll the machine. Reenrolling from
+scratch is `register.sh`.
+
+Needs `lab.env` from `env.sh`, `kubectl` able to exec into `deploy/nico-api`, plus
+`jq`, `python3` and `curl`. `qemu-io` is optional, see step 2.
+
+## Steps
+
+Numbers match the `[n/4]` markers the script prints. Steps 3 and 4 only run when
+there is no instance to reuse.
+
+1. **Look for a live instance.** Takes the instance on `MACHINE_ID`, or the first
+   instance that exists, whatever state its machine is in, and adopts its machine
+   id. Releasing is deliberately not done here because it triggers the full scrub.
+
+2. **Ensure the OS image.** Probes the remote qcow2 for the ext4 root UUID by
+   reading byte ranges with `qemu-io`, walking the GPT to the one ext4 partition,
+   roughly 2 MiB and no download. A successful probe overwrites
+   `OS_IMAGE_ROOTFS_UUID` even if you set it explicitly, and a failed probe only
+   warns. If the image id is already registered it compares the stored
+   `rootfs_id` and `boot_disk` and warns on a mismatch, since neither is settable
+   after create. Otherwise it reads `SHA512SUMS` next to the URL, aborting if the
+   digest cannot be found, and creates the image. The id is a UUIDv5 of the URL,
+   so reruns are idempotent. With no URL the step only checks that a preset
+   `OS_IMAGE_ID` is registered and aborts if not, and with neither it is skipped.
+
+3. **Wait for a Ready machine.** Waits on `MACHINE_ID` when pinned, otherwise
+   takes the first Ready machine no live instance claims. Then resolves the flat
+   VPC by name, because the API assigns its id.
+
+4. **Allocate.** A zero-DPU instance named `<BMH_NAME>_0` on the flat VPC with
+   auto networking. The allocate exit status is ignored, failure is detected by
+   re-querying for the instance and is always fatal. Output containing
+   `found unknown segments` additionally prints the two-NIC-on-one-segment
+   explanation.
+
+Both paths then converge:
+
+- A reused instance gets `instance update-os`, otherwise it would reimage with
+  the config it was allocated with rather than the current image and user data.
+- Waits for `assigned/ready`. A freshly allocated machine is still walking
+  Ready to PreAssignedMeasuring to Assigned, and skipping this makes the leave
+  check below pass on its first poll and report success with nothing installed.
+- Stages `USER_DATA` to a file inside the nico-api pod, since the CLI reads it
+  from disk, then sets it as a boot override on **every** non-BMC interface,
+  because the API picks the interface by source IP and the other port would find
+  none. Each write is read back and matched against a slice of the payload, `set`
+  exits 0 even when nothing lands. No interface, a readback without the payload,
+  or a `USER_DATA` with no non-comment line, is fatal rather than silently
+  imaging with the discovery template.
+- `instance reboot --custom-pxe`. Allocation alone leaves the machine serving
+  exit instructions, so this is what actually runs the install.
+- Waits for the host to **leave** `assigned/ready`, which is the install
+  starting, then to come back to it, which is the install finishing.
+- Prints the instance, machine, addresses and follow-up commands.
+
+## Inputs
+
+Read from `lab.env`: `BMH_NAME`, `BMC_IP`, `BMC_REDFISH_ID`, plus the
+`KUBECONFIG` it exports.
+
+| Variable | Default | Purpose |
+|---|---|---|
+| `MACHINE_ID` | unset | Pin a machine. Unset reuses the first instance, else the first unclaimed Ready machine |
+| `FLAT_VPC_NAME` | `devenv_flat_vpc` | VPC to allocate into |
+| `FLAT_VPC_ID` | unset | Set it to skip the name lookup |
+| `TENANT_ORG` | `devenv_test_org` | Owning org for the image |
+| `CLOUD_UNSAFE_OP` | `devenv` | Ack string for allocate, update-os and reboot |
+| `OS_IMAGE_BUILD` | `20260810-2566` | Dated build in the default URL, inert once `OS_IMAGE_URL` is set |
+| `OS_IMAGE_URL` | Debian 13 generic amd64 | Empty falls back to inline iPXE, unless `OS_IMAGE_ID` is set |
+| `OS_IMAGE_SHA` | read from `SHA512SUMS` | Digest for a new image |
+| `OS_IMAGE_ID` | UUIDv5 of the URL | With no URL, the image is only verified as registered |
+| `OS_IMAGE_ROOTFS_UUID` | `6d1bd696-738f-4565-8c0c-b1b51bc7c3d7` | Imager mounts root by UUID. A successful probe overrides it, including an explicit empty. Empty only drops the flag when the probe also fails |
+| `OS_IMAGE_BOOT_DISK` | `/dev/vda` | Imager only autodetects nvme0n1 and sda, empty drops the flag |
+| `IPXE_SCRIPT` | netboot.xyz chain | Used only when `OS_IMAGE_URL` is empty. Interpolated into the JSON unescaped, so it must not contain double quotes |
+| `USER_DATA` | inline cloud-config | Empty drops it from the OS config and skips the boot override |
+| `OS_JSON` | composed | Set it and the variant, user data and phone-home flags are not composed. Image registration and the boot override are unaffected |
+| `SETTLE_TIMEOUT` | `600` | Reaching assigned/ready before the install |
+| `LEAVE_TIMEOUT` | `600` | Host has to POST and netboot |
+| `PROVISION_TIMEOUT` | `1800` | Imaging plus the reboots after it |
+| `READY_TIMEOUT` | `900` | Only used when allocating |
+
+## Notes
+
+The default `USER_DATA` creates a `debian` user with passwordless sudo, two
+hardcoded ssh public keys, and the console password `debian`. SSH stays key only.
+Lab throwaway values, replace them anywhere else.
+
+The image URL pins a dated build, never `latest`. Upstream rebuilds `latest` in
+place, which moves the digest and the root UUID out from under an already
+registered os_image, both silently.
+
+Debian generic, not genericcloud, and not Ubuntu. An Ubuntu cloud image ships the
+virtual kernel with no `linux-modules-extra`, so it has no driver for the boot NIC.
+
+The instance `user_data` is only served while the machine is Assigned/Ready, and
+the imager fetches its seed mid install, so the boot override is the path that
+actually carries it.
+
+The root UUID probe needs `qemu-io` from `qemu-utils` plus its curl module, which
+Debian splits into `qemu-block-extra`. Without them the run falls back to whatever
+`OS_IMAGE_ROOTFS_UUID` holds, the default or your value or none, and says so.
