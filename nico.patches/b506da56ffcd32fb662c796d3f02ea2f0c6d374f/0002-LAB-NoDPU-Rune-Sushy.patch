+        get_resource: network
+      admin_state_up: true
+      port_security_enabled: false
+      fixed_ips:
+        - subnet:
+            get_resource: subnet
+          ip_address:
+            get_param: lb_ip
+
+  floating_ip_lb:
+    type: "OS::Neutron::FloatingIP"
+    properties:
+      floating_network:
+        get_param: external_network
+      port_id:
+        get_resource: port_lb
+
+  # Builder VM (24 vCPU, 64 GB RAM, 500 GB disk)
+  port_builder:
+    type: "OS::Neutron::Port"
+    properties:
+      name:
+        str_replace:
+          template: $prefix-port-builder
+          params:
+            $prefix:
+              get_param: prefix
+      network:
+        get_resource: network
+      admin_state_up: true
+      port_security_enabled: false
+      fixed_ips:
+        - subnet:
+            get_resource: subnet
+          ip_address:
+            get_param: builder_ip
+
+  secondary_port_builder:
+    type: "OS::Neutron::Port"
+    properties:
+      name:
+        str_replace:
+          template: $prefix-secondary-port-builder
+          params:
+            $prefix:
+              get_param: prefix
+      network:
+        get_resource: secondary_network
+      admin_state_up: true
+      port_security_enabled: false
+      fixed_ips:
+        - subnet:
+            get_resource: secondary_subnet
+          ip_address:
+            get_param: builder_secondary_ip
+
+  floating_ip_builder:
+    type: "OS::Neutron::FloatingIP"
+    properties:
+      floating_network:
+        get_param: external_network
+      port_id:
+        get_resource: port_builder
+
+  builder_wait_handle:
+    type: "OS::Heat::WaitConditionHandle"
+
+  builder_wait_condition:
+    type: "OS::Heat::WaitCondition"
+    properties:
+      handle:
+        get_resource: builder_wait_handle
+      timeout: 3600
+
+  builder_user_data:
+    type: "OS::Heat::Value"
+    properties:
+      value:
+        str_replace:
+          template: |
+            #cloud-config
+
+            # https://cloudinit.readthedocs.io/en/24.1/reference/examples.html
+            # Logs are in /var/log/cloud-init.log and /var/log/cloud-init-output.log
+
+            users:
+              - name: root
+                shell: /bin/bash
+                lock_passwd: true
+                ssh_authorized_keys: %ssh_keys%
+              - name: user
+                shell: /bin/bash
+                lock_passwd: true
+                sudo: ALL=(ALL) NOPASSWD:ALL
+                ssh_authorized_keys: %ssh_keys%
+
+            runcmd:
+              - |
+                export DEBIAN_FRONTEND=noninteractive
+
+                # Detect OS type
+                if [ -f /etc/os-release ]; then
+                  . /etc/os-release
+                  OS_ID="${ID}"
+                else
+                  OS_ID="unknown"
+                fi
+
+                # Perform OS-specific updates
+                case "${OS_ID}" in
+                  debian)
+                    apt-get update
+                    apt-get -y \
+                      -o Dpkg::Options::="--force-confdef" \
+                      -o Dpkg::Options::="--force-confold" \
+                      upgrade
+                    apt-get -y \
+                      -o Dpkg::Options::="--force-confdef" \
+                      -o Dpkg::Options::="--force-confold" \
+                      install git ansible tmux
+                    ;;
+                  *)
+                    echo "Unknown OS: ${OS_ID}, skipping package updates"
+                    ;;
+                esac
+
+                # Configure SSH
+                sed -i \
+                  -e '/^[[:space:]]*#*[[:space:]]*Include/d' \
+                  -e '/^[[:space:]]*#*[[:space:]]*PermitRootLogin/d' \
+                  -e '/^[[:space:]]*#*[[:space:]]*PasswordAuthentication/d' \
+                  -e '/^[[:space:]]*#*[[:space:]]*PermitEmptyPasswords/d' \
+                  -e '$a\PermitRootLogin prohibit-password' \
+                  -e '$a\PasswordAuthentication no' \
+                  -e '$a\PermitEmptyPasswords no' \
+                  /etc/ssh/sshd_config
+
+                # Restart SSH service
+                systemctl restart sshd || systemctl restart ssh
+
+                RESULT=$?
+
+                if [ $RESULT -eq 0 ]; then
+                  %wc_notify% --data-binary "{\"status\": \"SUCCESS\", \"data\": \"Builder cloud-init completed\"}"
+                else
+                  %wc_notify% --data-binary "{\"status\": \"FAILURE\", \"reason\": \"Builder cloud-init failed\"}"
+                  exit 1
+                fi
+          params:
+            "%ssh_keys%":
+              get_attr:
+                - ssh_authorized_keys
+                - value
+            "%wc_notify%":
+              get_attr:
+                - builder_wait_handle
+                - curl_cli
+
+  builder:
+    type: "OS::Nova::Server"
+    properties:
+      name:
+        str_replace:
+          template: "%prefix%-builder"
+          params:
+            "%prefix%":
+              get_param: prefix
+      availability_zone:
+        get_param: availability_zone
+      flavor:
+        get_param: builder_flavor
+      config_drive: true
+      block_device_mapping_v2:
+        - image_id:
