+          delete_on_termination: true
+          boot_index: 0
+          volume_size:
+            get_param: builder_volume_size
+      networks:
+        - port:
+            get_resource: port_builder
+        - port:
+            get_resource: secondary_port_builder
+      user_data_format: RAW
+      user_data:
+        get_attr:
+          - builder_user_data
+          - value
+
+  # Mgmt VM (20 vCPU, 32 GB RAM, 250 GB disk)
+  port_mgmt:
+    type: "OS::Neutron::Port"
+    properties:
+      name:
+        str_replace:
+          template: $prefix-port-mgmt
+          params:
+            $prefix:
+              get_param: prefix
+      network:
+        get_resource: network
+      admin_state_up: true
+      port_security_enabled: false
+      fixed_ips:
+        - subnet:
+            get_resource: subnet
+          ip_address:
+            get_param: mgmt_ip
+
+  secondary_port_mgmt:
+    type: "OS::Neutron::Port"
+    properties:
+      name:
+        str_replace:
+          template: $prefix-secondary-port-mgmt
+          params:
+            $prefix:
+              get_param: prefix
+      network:
+        get_resource: secondary_network
+      admin_state_up: true
+      port_security_enabled: false
+      fixed_ips:
+        - subnet:
+            get_resource: secondary_subnet
+          ip_address:
+            get_param: mgmt_secondary_ip
+
+  floating_ip_mgmt:
+    type: "OS::Neutron::FloatingIP"
+    properties:
+      floating_network:
+        get_param: external_network
+      port_id:
+        get_resource: port_mgmt
+
+  mgmt_wait_handle:
+    type: "OS::Heat::WaitConditionHandle"
+
+  mgmt_wait_condition:
+    type: "OS::Heat::WaitCondition"
+    properties:
+      handle:
+        get_resource: mgmt_wait_handle
+      timeout: 3600
+
+  mgmt_user_data:
+    type: "OS::Heat::Value"
+    properties:
+      value:
+        str_replace:
+          template: |
+            #cloud-config
+
+            # https://cloudinit.readthedocs.io/en/24.1/reference/examples.html
+            # Logs are in /var/log/cloud-init.log and /var/log/cloud-init-output.log
+
+            users:
+              - name: root
+                shell: /bin/bash
+                lock_passwd: true
+                ssh_authorized_keys: %ssh_keys%
+              - name: user
+                shell: /bin/bash
+                lock_passwd: true
+                sudo: ALL=(ALL) NOPASSWD:ALL
+                ssh_authorized_keys: %ssh_keys%
+
+            runcmd:
+              - |
+                export DEBIAN_FRONTEND=noninteractive
+
+                # Detect OS type
+                if [ -f /etc/os-release ]; then
+                  . /etc/os-release
+                  OS_ID="${ID}"
+                else
+                  OS_ID="unknown"
+                fi
+
+                # Perform OS-specific updates
+                case "${OS_ID}" in
+                  debian)
+                    apt-get update
+                    apt-get -y \
+                      -o Dpkg::Options::="--force-confdef" \
+                      -o Dpkg::Options::="--force-confold" \
+                      upgrade
+                    apt-get -y \
+                      -o Dpkg::Options::="--force-confdef" \
+                      -o Dpkg::Options::="--force-confold" \
+                      install git ansible tmux
+                    ;;
+                  *)
+                    echo "Unknown OS: ${OS_ID}, skipping package updates"
+                    ;;
+                esac
+
+                # Configure SSH
+                sed -i \
+                  -e '/^[[:space:]]*#*[[:space:]]*Include/d' \
+                  -e '/^[[:space:]]*#*[[:space:]]*PermitRootLogin/d' \
+                  -e '/^[[:space:]]*#*[[:space:]]*PasswordAuthentication/d' \
+                  -e '/^[[:space:]]*#*[[:space:]]*PermitEmptyPasswords/d' \
+                  -e '$a\PermitRootLogin prohibit-password' \
+                  -e '$a\PasswordAuthentication no' \
+                  -e '$a\PermitEmptyPasswords no' \
+                  /etc/ssh/sshd_config
+
+                # Restart SSH service
+                systemctl restart sshd || systemctl restart ssh
+
+                RESULT=$?
+
+                if [ $RESULT -eq 0 ]; then
+                  %wc_notify% --data-binary "{\"status\": \"SUCCESS\", \"data\": \"Mgmt cloud-init completed\"}"
+                else
+                  %wc_notify% --data-binary "{\"status\": \"FAILURE\", \"reason\": \"Mgmt cloud-init failed\"}"
+                  exit 1
+                fi
+          params:
+            "%ssh_keys%":
+              get_attr:
+                - ssh_authorized_keys
+                - value
+            "%wc_notify%":
+              get_attr:
+                - mgmt_wait_handle
+                - curl_cli
+
+  mgmt:
+    type: "OS::Nova::Server"
+    properties:
+      name:
+        str_replace:
+          template: "%prefix%-mgmt"
+          params:
+            "%prefix%":
+              get_param: prefix
+      availability_zone:
+        get_param: availability_zone
+      flavor:
+        get_param: mgmt_flavor
+      config_drive: true
+      block_device_mapping_v2:
+        - image_id:
+            get_param: image_id
+          delete_on_termination: true
+          boot_index: 0
+          volume_size:
+            get_param: mgmt_volume_size
+      networks:
+        - port:
+            get_resource: port_mgmt
+        - port:
+            get_resource: secondary_port_mgmt
+      user_data_format: RAW
+      user_data:
+        get_attr:
+          - mgmt_user_data
+          - value
+
+  # Worker VM (16 vCPU, 32 GB RAM, 200 GB disk)
+  port_worker:
+    type: "OS::Neutron::Port"
+    properties:
+      name:
+        str_replace:
+          template: $prefix-port-worker
+          params:
+            $prefix:
+              get_param: prefix
+      network:
+        get_resource: network
+      admin_state_up: true
+      port_security_enabled: false
+      fixed_ips:
+        - subnet:
+            get_resource: subnet
+          ip_address:
+            get_param: worker_ip
+
+  secondary_port_worker:
+    type: "OS::Neutron::Port"
+    properties:
+      name:
+        str_replace:
+          template: $prefix-secondary-port-worker
+          params:
+            $prefix:
+              get_param: prefix
+      network:
+        get_resource: secondary_network
+      admin_state_up: true
+      port_security_enabled: false
+      fixed_ips:
+        - subnet:
+            get_resource: secondary_subnet
+          ip_address:
+            get_param: worker_secondary_ip
+
+  floating_ip_worker:
+    type: "OS::Neutron::FloatingIP"
+    properties:
+      floating_network:
+        get_param: external_network
+      port_id:
+        get_resource: port_worker
+
+  worker_wait_handle:
+    type: "OS::Heat::WaitConditionHandle"
+
+  worker_wait_condition:
+    type: "OS::Heat::WaitCondition"
+    properties:
+      handle:
+        get_resource: worker_wait_handle
+      timeout: 3600
+
+  worker_user_data:
+    type: "OS::Heat::Value"
+    properties:
+      value:
+        str_replace:
+          template: |
+            #cloud-config
+
+            # https://cloudinit.readthedocs.io/en/24.1/reference/examples.html
+            # Logs are in /var/log/cloud-init.log and /var/log/cloud-init-output.log
+
+            users:
+              - name: root
+                shell: /bin/bash
+                lock_passwd: true
+                ssh_authorized_keys: %ssh_keys%
+              - name: user
+                shell: /bin/bash
+                lock_passwd: true
+                sudo: ALL=(ALL) NOPASSWD:ALL
+                ssh_authorized_keys: %ssh_keys%
+
+            runcmd:
+              - |
+                export DEBIAN_FRONTEND=noninteractive
+
+                # Detect OS type
+                if [ -f /etc/os-release ]; then
+                  . /etc/os-release
+                  OS_ID="${ID}"
+                else
+                  OS_ID="unknown"
+                fi
+
+                # Perform OS-specific updates
+                case "${OS_ID}" in
+                  debian)
+                    apt-get update
+                    apt-get -y \
+                      -o Dpkg::Options::="--force-confdef" \
+                      -o Dpkg::Options::="--force-confold" \
+                      upgrade
+                    apt-get -y \
+                      -o Dpkg::Options::="--force-confdef" \
+                      -o Dpkg::Options::="--force-confold" \
+                      install git ansible tmux
+                    ;;
+                  *)
+                    echo "Unknown OS: ${OS_ID}, skipping package updates"
+                    ;;
+                esac
+
+                # Configure SSH
+                sed -i \
+                  -e '/^[[:space:]]*#*[[:space:]]*Include/d' \
+                  -e '/^[[:space:]]*#*[[:space:]]*PermitRootLogin/d' \
+                  -e '/^[[:space:]]*#*[[:space:]]*PasswordAuthentication/d' \
+                  -e '/^[[:space:]]*#*[[:space:]]*PermitEmptyPasswords/d' \
+                  -e '$a\PermitRootLogin prohibit-password' \
+                  -e '$a\PasswordAuthentication no' \
+                  -e '$a\PermitEmptyPasswords no' \
+                  /etc/ssh/sshd_config
+
+                # Restart SSH service
+                systemctl restart sshd || systemctl restart ssh
+
+                RESULT=$?
+
+                if [ $RESULT -eq 0 ]; then
+                  %wc_notify% --data-binary "{\"status\": \"SUCCESS\", \"data\": \"Worker cloud-init completed\"}"
+                else
+                  %wc_notify% --data-binary "{\"status\": \"FAILURE\", \"reason\": \"Worker cloud-init failed\"}"
+                  exit 1
+                fi
+          params:
+            "%ssh_keys%":
+              get_attr:
+                - ssh_authorized_keys
+                - value
+            "%wc_notify%":
+              get_attr:
+                - worker_wait_handle
+                - curl_cli
+
+  worker:
+    type: "OS::Nova::Server"
+    properties:
+      name:
+        str_replace:
+          template: "%prefix%-worker"
+          params:
+            "%prefix%":
+              get_param: prefix
+      availability_zone:
+        get_param: availability_zone
+      flavor:
+        get_param: worker_flavor
+      config_drive: true
+      block_device_mapping_v2:
+        - image_id:
+            get_param: image_id
+          delete_on_termination: true
+          boot_index: 0
+          volume_size:
+            get_param: worker_volume_size
+      networks:
+        - port:
+            get_resource: port_worker
+        - port:
+            get_resource: secondary_port_worker
+      user_data_format: RAW
+      user_data:
+        get_attr:
+          - worker_user_data
+          - value
+
+outputs:
+  lb_floating_ip:
+    description: Floating IP address for the LoadBalancer VIP (primary network)
+    value:
+      get_attr:
+        - floating_ip_lb
+        - floating_ip_address
+
+  builder_floating_ip:
