@@ -0,0 +1,646 @@
+---
+# Copyright 2026 s3rj1k
+# SPDX-License-Identifier: MIT
+
+# Prepares this host and builds the NICo images from the checkout this playbook
+# lives in. Nothing is cloned, the working tree as it stands is what gets built.
+#
+#   ansible-playbook lab/ansible/build.yml -K
+#   ansible-playbook lab/ansible/build.yml -K -e nico_clean=true       # reclaim first
+#   ansible-playbook lab/ansible/build.yml -K -e image_tag=v0.0.1      # custom tag
+#   ansible-playbook lab/ansible/build.yml -K --tags tools             # host setup only
+#   ansible-playbook lab/ansible/build.yml -K -e force_tools=true      # refetch CLIs
+#
+# Tags are tools, clean and build. Needs Debian or Ubuntu amd64, passwordless
+# sudo, and a prior `docker login` as the invoking user (not root).
+
+- name: Build NICo images from this checkout
+  hosts: localhost
+  connection: local
+  become: true
+  environment:
+    # Forwards the invoking user's SSH agent through sudo, so a submodule fetch
+    # over an ssh remote stays authenticated.
+    SSH_AUTH_SOCK: "{{ lookup('env', 'SSH_AUTH_SOCK') }}"
+
+  vars:
+    # ansible_env.HOME is root because fact gathering runs with become true.
+    build_user_home: "{{ lookup('env', 'HOME') }}"
+    # The repo to build, the checkout this playbook lives in rather than a clone.
+    nico_repo_path: "{{ playbook_dir }}/../.."
+    min_free_disk_gb: 150
+    # kubectl minor to match the mgmt k0s track in mgmt.yaml.
+    builder_kubectl_channel: "1.35"
+    # Registry host used for the docker login check below.
+    image_registry: "oci.s3rj1k.fyi"
+    # Subfolder the images publish under so they are not at the registry root.
+    image_namespace: "nv"
+    # Full repository prefix passed to make and used for the registry ref checks.
+    image_repo: "{{ image_registry }}/{{ image_namespace }}"
+    # Ref the auto tag is derived from. HEAD~1 is the rune vendor commit so
+    # amending the WiP lab commit on top does not churn the tag or rebuild images.
+    nico_tag_ref: "HEAD~1"
+    # Empty derives the tag from nico_tag_ref not wall clock time, so it stays stable
+    # across runs. Override with image_tag, it must start with v then a digit.
+    image_tag: ""
+    # Rebuild even when the tag already resolves in the registry. Leave false with a
+    # derived tag so a re-run is cheap, set true when reusing one fixed tag locally.
+    force_rebuild: false
+    # Install the CLI toolchain (kubectl, helm, helmfile, ytt, yq), only the ones
+    # missing from /usr/local/bin. Off once the host is set up and you only rebuild.
+    install_tools: true
+    # Refetch the CLI toolchain even when the binaries are already installed. Leave
+    # false so a rerun never depends on GitHub being reachable.
+    force_tools: false
+    # Reclaim before building. Docker images/caches only, see clean_repo_tree.
+    nico_clean: false
+    # Also `git clean -xfd` the checkout, which deletes untracked and ignored files.
+    # lab/scripts/lab.env and whatever apply.sh wrote go with it, so it stays off.
+    clean_repo_tree: false
+    # mkosi builds the boot artifacts inside a user namespace, which Ubuntu 24.04
+    # blocks by default. Set false on hosts that never build scout.
+    mkosi_userns_enabled: true
+    # Build output is redirected here not captured because the stream is large
+    # and can carry non UTF8 bytes that trip Ansible strict UTF8 checks.
+    nico_build_log: "{{ build_user_home }}/nico-images-build.log"
+    # One toggle per make target, flip any to false to skip that target. Core
+    # needs base so make rebuilds base as a prerequisite when core runs.
+    nico_build_base: true
+    nico_build_core: true
+    nico_build_rest: true
+    nico_build_machine_validation: true
+    nico_build_boot_artifacts: true
+    nico_build_bfb: true
+    # Cargo keys host arch build scripts by rustc version and never by libc, and the
+    # cross container shares this target dir, so drop what it is too old to execute.
+    nico_bfb_pre_clean: |
+      cross_image="build-artifacts-container-cross-aarch64:latest"
+      floor=""
+      if sg docker -c "docker image inspect ${cross_image}" >/dev/null 2>&1; then
+        floor=$(sg docker -c "docker run --rm ${cross_image} getconf GNU_LIBC_VERSION" 2>/dev/null | awk '{print $NF}')
+      fi
+      floor="${floor:-2.36}"
+      too_new=""
+      for f in target/release/build/*/build-script-* target/release/deps/*.so; do
+        [ -f "${f}" ] || continue
+        need=$(grep -ao 'GLIBC_2\.[0-9]*' "${f}" | sed 's/GLIBC_//' | sort -V | tail -1)
+        [ -n "${need}" ] || continue
+        if [ "$(printf '%s\n%s\n' "${floor}" "${need}" | sort -V | tail -1)" != "${floor}" ]; then
+          too_new="${f} needs glibc ${need}, the cross container has ${floor}"
+          break
+        fi
+      done
+      if [ -n "${too_new}" ]; then
+        echo "CLEAN host arch cargo artifacts, ${too_new}"
+        rm -rf target/release/build target/release/deps target/release/.fingerprint
+      fi
+    # Shared body for the build tasks below. Runs the optional build_pre hook then
+    # make build_target, skipping both when every ref is already in the registry.
+    nico_build_step: |
+      set -o pipefail
+      if [ "{{ force_rebuild | bool | ternary('1', '0') }}" != "1" ]; then
+        all_present=1
+        for ref in {{ build_refs | map('regex_replace', '^', image_repo ~ '/') | join(' ') }}; do
+          if sg docker -c "docker buildx imagetools inspect ${ref}" >/dev/null 2>&1; then
+            echo "present ${ref}"
+          else
+            echo "missing ${ref}"
+            all_present=0
+          fi
+        done
+        if [ "${all_present}" = "1" ]; then
+          echo "SKIP {{ build_target }} already in {{ image_repo }} at {{ image_tag }}"
+          exit 0
+        fi
+      fi
+      echo "BUILD {{ build_target }}"
+      {{ build_pre | default('') }}
+      printf '\n===== make %s IMAGE_TAG=%s =====\n' "{{ build_target }}" "{{ image_tag }}" >>{{ nico_build_log | quote }}
+      if ! sg docker -c "make {{ build_target }} IMAGE_REGISTRY={{ image_repo }} IMAGE_TAG={{ image_tag }}" >>{{ nico_build_log | quote }} 2>&1; then
+        echo "make {{ build_target }} failed, see {{ nico_build_log }} e.g. tail -n 80 {{ nico_build_log }}"
+        exit 1
+      fi
+
+  pre_tasks:
+    # mkosi needs amd64 and the make targets assume a Debian family host.
+    - name: Assert the host is Debian family on amd64
+      ansible.builtin.assert:
+        that:
+          - ansible_facts.os_family == "Debian"
+          - ansible_facts.architecture == "x86_64"
+        fail_msg: "build.yml supports Debian/Ubuntu amd64 only."
+      tags: [always]
+
+    - name: Resolve the repository path
+      ansible.builtin.command: readlink -f {{ nico_repo_path | quote }} # noqa: command-instead-of-module
+      register: nico_repo_resolved
+      become: false
+      changed_when: false
+      tags: [always]
+
+    - name: Use the resolved repository path
+      ansible.builtin.set_fact:
+        nico_repo_path: "{{ nico_repo_resolved.stdout }}"
+      tags: [always]
+
+    - name: Stat the repository Makefile
+      ansible.builtin.stat:
+        path: "{{ nico_repo_path }}/Makefile"
+      register: nico_makefile_stat
+      tags: [always]
+
+    - name: Fail when the repository has no Makefile
+      ansible.builtin.assert:
+        that: nico_makefile_stat.stat.exists
+        fail_msg: >-
+          No Makefile at {{ nico_repo_path }}. This playbook builds the checkout
+          it lives in; point nico_repo_path at one if you moved it.
+      tags: [always]
+
+    - name: Check free disk space on /
+      ansible.builtin.command: df -B1 --output=avail / # noqa: command-instead-of-module
+      register: root_avail
+      changed_when: false
+      tags: [always]
+
+    - name: Fail if free disk space is below the minimum
+      ansible.builtin.assert:
+        that: (root_avail.stdout_lines[1] | trim | int) >= (min_free_disk_gb | int) * 1024 * 1024 * 1024
+        fail_msg: >-
+          Less than {{ min_free_disk_gb }}G free on /, the image build needs it.
+      tags: [always]
+
+  tasks:
+    # WARNING, the prune steps are host wide and reclaim every unused docker
+    # resource, not only NICo's. Local only, no remote registry or cluster.
+    - name: Reclaim disk before building
+      when: nico_clean | bool
+      tags: [clean]
+      block:
+        # sg applies the docker group without needing a fresh login. Runs as the
+        # real user so it uses their docker access.
+        - name: Remove locally-built images under {{ image_registry }}
+          ansible.builtin.shell: |
+            set -o pipefail
+            ids=$(sg docker -c "docker images --filter=reference='{{ image_registry }}/*' -q" | sort -u | tr '\n' ' ')
+            if [ -n "${ids}" ]; then
+              sg docker -c "docker rmi -f ${ids}"
+            fi
+          args:
+            executable: /bin/bash
+          become: false
+          register: rmi_local
+          changed_when: rmi_local.stdout | trim | length > 0
+
+        - name: Prune docker (all unused images, containers, networks, volumes)
+          ansible.builtin.command: sg docker -c "docker system prune -af --volumes"
+          become: false
+          changed_when: true
+
+        - name: Prune docker build cache
+          ansible.builtin.command: sg docker -c "docker builder prune -af"
+          become: false
+          changed_when: true
+
+        - name: Remove mkosi and sccache caches
+          ansible.builtin.file:
+            path: "{{ item }}"
+            state: absent
+          loop:
+            - "{{ build_user_home }}/.cache/mkosi"
+            - "{{ build_user_home }}/.cache/sccache"
+            - "{{ build_user_home }}/.sccache"
+
+        # file module can't glob, and these are often root-owned (mkosi runs as root).
+        - name: Remove /tmp build artifacts
+          ansible.builtin.shell: rm -rf /tmp/bfb-dump /tmp/mkosi.output-* # noqa: command-instead-of-module
+          changed_when: true
+
+        - name: Warn that the checkout is about to be wiped
+          ansible.builtin.debug:
+            msg: >-
+              clean_repo_tree=true removes every untracked and ignored file under
+              {{ nico_repo_path }}, including lab/scripts/lab.env (BMC_PASSWORD) and
+              whatever lab/patches/apply.sh wrote. Re-run env.sh and apply.sh after.
+          when: clean_repo_tree | bool
+
+        # -xfd (not -xffd) keeps the nested-repo guard so sibling git repos survive.
+        - name: Clean the repo working tree
+          ansible.builtin.command: git clean -xfd # noqa: command-instead-of-module
+          args:
+            chdir: "{{ nico_repo_path }}"
+          become: false
+          changed_when: true
+          when: clean_repo_tree | bool
+
+        # docker save (images-machine-validation) drops these into the tracked images
+        # dir, git clean above sweeps them and this is the explicit pass.
+        - name: Find machine-validation image tarballs
+          ansible.builtin.find:
+            paths: "{{ nico_repo_path }}/crates/machine-validation/images"
+            patterns: "*.tar"
+          register: mv_image_tars
+          become: false
+          when: clean_repo_tree | bool
+
+        - name: Remove machine-validation image tarballs
+          ansible.builtin.file:
+            path: "{{ item.path }}"
+            state: absent
+          loop: "{{ mv_image_tars.files | default([]) }}"
+          loop_control:
+            label: "{{ item.path }}"
+          when: clean_repo_tree | bool
+
+    # CLI the builder uses to drive the mgmt cluster and apply the lab patches.
+    # kubectl tracks the k0s minor from mgmt.yaml, the rest take their latest.
+    - name: Install the host toolchain
+      when: install_tools | bool
+      tags: [tools]
+      block:
+        # provision-instance.sh reads the root fs uuid straight off the published
+        # qcow2, which needs qemu-io plus its separately packaged curl block driver.
+        - name: Install basic tools
+          ansible.builtin.apt:
+            name:
+              - git
+              - jq
+              - make
+              - pigz
+              - qemu-block-extra
+              - qemu-utils
+            state: present
+            update_cache: true
+            cache_valid_time: 3600
+
+        # None of these is version pinned, so a binary already in /usr/local/bin is
+        # good enough and skipping it also skips the release lookup that can fail.
+        - name: Check which CLI tools are already installed
+          ansible.builtin.stat:
+            path: "/usr/local/bin/{{ item }}"
+          loop:
+            - kubectl
+            - helm
+            - helmfile
+            - ytt
+            - yq
+          register: builder_cli_tools
+
+        - name: Select the CLI tools that need installing
+          ansible.builtin.set_fact:
+            install_cli_tools: >-
+              {{ (force_tools | bool)
+                 | ternary(builder_cli_tools.results | map(attribute='item'),
+                           builder_cli_tools.results | rejectattr('stat.exists') | map(attribute='item'))
+                 | list }}
+
+        - name: Report the CLI tools already present
+          ansible.builtin.debug:
+            msg: >-
+              Already installed, skipping:
+              {{ builder_cli_tools.results | map(attribute='item') | difference(install_cli_tools) | join(', ') }}
+          when: install_cli_tools | length < builder_cli_tools.results | length
+
+        - name: Resolve the latest kubectl patch for the mgmt k0s minor
+          ansible.builtin.uri:
+            url: "https://dl.k8s.io/release/stable-{{ builder_kubectl_channel }}.txt"
+            return_content: true
+          register: kubectl_stable
+          changed_when: false
+          when: "'kubectl' in install_cli_tools"
+
+        - name: Install kubectl
+          ansible.builtin.get_url:
+            url: "https://dl.k8s.io/release/{{ kubectl_stable.content | trim }}/bin/linux/amd64/kubectl"
+            dest: /usr/local/bin/kubectl
+            mode: "0755"
+          when: "'kubectl' in install_cli_tools"
+
+        - name: Resolve the latest helm release tag
+          ansible.builtin.uri:
+            url: https://api.github.com/repos/helm/helm/releases/latest
+            return_content: true
+          register: helm_release
+          changed_when: false
+          when: "'helm' in install_cli_tools"
+
+        - name: Install helm
+          ansible.builtin.unarchive:
+            src: "https://get.helm.sh/helm-{{ helm_release.json.tag_name }}-linux-amd64.tar.gz"
+            dest: /usr/local/bin
+            remote_src: true
+            include:
+              - linux-amd64/helm
+            extra_opts:
+              - --strip-components=1
+          when: "'helm' in install_cli_tools"
+
+        - name: Resolve the latest helmfile release tag
+          ansible.builtin.uri:
+            url: https://api.github.com/repos/helmfile/helmfile/releases/latest
+            return_content: true
+          register: helmfile_release
+          changed_when: false
+          when: "'helmfile' in install_cli_tools"
+
+        - name: Install helmfile
+          vars:
+            helmfile_tag: "{{ helmfile_release.json.tag_name }}"
+            helmfile_ver: "{{ helmfile_release.json.tag_name | regex_replace('^v', '') }}"
+          ansible.builtin.unarchive:
+            src: "https://github.com/helmfile/helmfile/releases/download/{{ helmfile_tag }}/helmfile_{{ helmfile_ver }}_linux_amd64.tar.gz"
+            dest: /usr/local/bin
+            remote_src: true
+            include:
+              - helmfile
+          when: "'helmfile' in install_cli_tools"
+
+        - name: Install ytt
+          ansible.builtin.get_url:
+            url: https://github.com/carvel-dev/ytt/releases/latest/download/ytt-linux-amd64
+            dest: /usr/local/bin/ytt
+            mode: "0755"
+          when: "'ytt' in install_cli_tools"
+
+        - name: Install yq
+          ansible.builtin.get_url:
+            url: https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64
+            dest: /usr/local/bin/yq
+            mode: "0755"
+          when: "'yq' in install_cli_tools"
+
+    - name: Build the images
+      tags: [build]
+      block:
+        # Without this mkosi cannot unshare and the scout image build dies on
+        # PermissionError. It relaxes the guard for the whole host.
+        - name: Allow unprivileged user namespaces so mkosi can build
+          ansible.builtin.copy:
+            dest: /etc/sysctl.d/60-mkosi-userns.conf
+            mode: "0644"
+            content: |
+              kernel.apparmor_restrict_unprivileged_userns=0
+          register: mkosi_userns_conf
+          when: mkosi_userns_enabled | bool
+
+        - name: Reload sysctl so the namespace change applies now
+          when: mkosi_userns_enabled | bool and mkosi_userns_conf.changed
+          ansible.builtin.command: sysctl --system # noqa: command-instead-of-module
+          changed_when: true
+
+        # mkosi and pxe/ipxe get dirtied by the build. Reset them to their pinned
+        # commits each run so the dirt never shows up as a change to this checkout.
+        - name: Reset git submodules to their pinned commits
+          ansible.builtin.command: git submodule update --init --recursive --force # noqa: command-instead-of-module
+          args:
+            chdir: "{{ nico_repo_path }}"
+          become: false
+          changed_when: false
+
+        - name: Drop untracked files left inside submodules by the build
+          ansible.builtin.command: git submodule foreach --recursive git clean -ffdx # noqa: command-instead-of-module
+          args:
+            chdir: "{{ nico_repo_path }}"
+          become: false
+          changed_when: false
+
+        - name: Get the tag ref short hash
+          ansible.builtin.command: git rev-parse --short {{ nico_tag_ref }} # noqa: command-instead-of-module
+          args:
+            chdir: "{{ nico_repo_path }}"
+          become: false
+          register: nico_commit_hash
+          changed_when: false
+          when: image_tag | length == 0
+
+        - name: Get the tag ref committer timestamp (stable, unlike build time)
+          ansible.builtin.command: git show -s --format=%ct {{ nico_tag_ref }} # noqa: command-instead-of-module
+          args:
+            chdir: "{{ nico_repo_path }}"
+          become: false
+          register: nico_commit_epoch
+          changed_when: false
+          when: image_tag | length == 0
+
+        # A commit derived tag only matches the built bits on a clean tree, and
+        # building a patched checkout is normal here, so say so and carry on.
+        - name: Check the working tree before deriving a tag from the commit
+          ansible.builtin.command: git status --porcelain --ignore-submodules=dirty # noqa: command-instead-of-module
+          args:
+            chdir: "{{ nico_repo_path }}"
+          become: false
+          register: nico_git_status
+          changed_when: false
+          when: image_tag | length == 0
+
+        - name: Warn that a derived tag will not match a dirty tree
+          ansible.builtin.debug:
+            msg: >-
+              WARNING: {{ nico_repo_path }} has uncommitted changes, so the derived
+              tag names {{ nico_tag_ref }} while the build also carries those edits.
+              Pass -e image_tag=... to name the result explicitly.
+          when:
+            - image_tag | length == 0
+            - nico_git_status.stdout | default('') | trim | length > 0
+
+        - name: Derive default image tag from the commit timestamp and hash
+          ansible.builtin.set_fact:
+            image_tag: "v{{ nico_commit_epoch.stdout }}-{{ nico_commit_hash.stdout }}"
+          when: image_tag | length == 0
+
+        # Requires passwordless sudo since the underlying script escalates internally.
+        - name: Run make bootstrap
+          ansible.builtin.command: make bootstrap
+          args:
+            chdir: "{{ nico_repo_path }}"
+          become: false
+          changed_when: true
+
+        - name: Stat the docker credentials file
+          ansible.builtin.stat:
+            path: "{{ build_user_home }}/.docker/config.json"
+          register: docker_config_stat
+          become: false
+
+        - name: Read the docker credentials file
+          ansible.builtin.slurp:
+            src: "{{ build_user_home }}/.docker/config.json"
+          register: docker_config_raw
+          become: false
+          when: docker_config_stat.stat.exists
+
+        # Catches missing registry auth before the long build instead of after.
+        # Only checks a credential entry exists, not that it still works.
+        - name: Verify docker is logged in to {{ image_registry }}
+          ansible.builtin.assert:
+            that: >-
+              docker_config_stat.stat.exists
+              and image_registry in ((docker_config_raw.content | b64decode | from_json).auths | default({}))
+            fail_msg: >-
+              Not logged in to {{ image_registry }}. Run `docker login {{ image_registry }}`
+              as this playbook's invoking user (not root), then re-run this playbook.
+
+        - name: Report what is about to be built
+          ansible.builtin.debug:
+            msg: >-
+              Building {{ nico_repo_path }} into {{ image_repo }} at {{ image_tag }}
+              (force_rebuild={{ force_rebuild }})
+
+        # Truncate once so the per step appends below start from an empty log.
+        - name: Start a fresh build log
+          ansible.builtin.copy:
+            dest: "{{ nico_build_log }}"
+            content: ""
+            mode: "0644"
+          become: false
+
+        # One task per make target so each is its own step in the play recap.
+        - name: Build the container images one make target at a time
+          become: false
+          environment:
+            PATH: "{{ build_user_home }}/.cargo/bin:{{ ansible_env.PATH }}"
+          block:
+            - name: Build the Core base build-containers
+              ansible.builtin.shell: "{{ nico_build_step }}"
+              args:
+                executable: /bin/bash
+                chdir: "{{ nico_repo_path }}"
+              vars:
+                build_target: images-base
+                build_refs:
+                  - "nico-buildcontainer:{{ image_tag }}-amd64"
+                  - "nico-buildcontainer:{{ image_tag }}-arm64"
+                  - "nico-runtime-container:{{ image_tag }}-amd64"
+                  - "nico-runtime-container:{{ image_tag }}-arm64"
+              when: nico_build_base | bool
+              register: nico_build_base_result
+              changed_when: "'BUILD ' in nico_build_base_result.stdout"
+
+            - name: Build the NICo Core image (nico)
+              ansible.builtin.shell: "{{ nico_build_step }}"
+              args:
+                executable: /bin/bash
+                chdir: "{{ nico_repo_path }}"
+              vars:
+                build_target: images-core
+                build_refs:
+                  - "nico:{{ image_tag }}"
+              when: nico_build_core | bool
+              register: nico_build_core_result
+              changed_when: "'BUILD ' in nico_build_core_result.stdout"
+
+            - name: Build the REST service images
+              ansible.builtin.shell: "{{ nico_build_step }}"
+              args:
+                executable: /bin/bash
+                chdir: "{{ nico_repo_path }}"
+              vars:
+                build_target: images-rest
+                build_refs:
+                  - "nico-rest-api:{{ image_tag }}"
+                  - "nico-rest-workflow:{{ image_tag }}"
+                  - "nico-rest-site-manager:{{ image_tag }}"
+                  - "nico-rest-site-agent:{{ image_tag }}"
+                  - "nico-rest-db:{{ image_tag }}"
+                  - "nico-rest-cert-manager:{{ image_tag }}"
+                  - "nico-flow:{{ image_tag }}"
+                  - "nico-psm:{{ image_tag }}"
+                  - "nico-nsm:{{ image_tag }}"
+                  - "nico-mcp:{{ image_tag }}"
+              when: nico_build_rest | bool
+              register: nico_build_rest_result
+              changed_when: "'BUILD ' in nico_build_rest_result.stdout"
+
+            # Also writes a local runner tar under the machine validation images dir.
+            # Skipping when the remote already exists does not regenerate that tar.
+            - name: Build the machine-validation images
+              ansible.builtin.shell: "{{ nico_build_step }}"
+              args:
+                executable: /bin/bash
+                chdir: "{{ nico_repo_path }}"
+              vars:
+                build_target: images-machine-validation
+                build_refs:
+                  - "machine-validation:{{ image_tag }}"
+              when: nico_build_machine_validation | bool
+              register: nico_build_mv_result
+              changed_when: "'BUILD ' in nico_build_mv_result.stdout"
+
+            - name: Build the x86 boot-artifact image
+              ansible.builtin.shell: "{{ nico_build_step }}"
+              args:
+                executable: /bin/bash
+                chdir: "{{ nico_repo_path }}"
+              vars:
+                build_target: images-boot-artifacts
+                build_refs:
+                  - "boot-artifacts-x86_64:{{ image_tag }}"
+              when: nico_build_boot_artifacts | bool
+              register: nico_build_boot_result
+              changed_when: "'BUILD ' in nico_build_boot_result.stdout"
+
+            - name: Build the aarch64 DPU BFB image
+              ansible.builtin.shell: "{{ nico_build_step }}"
+              args:
+                executable: /bin/bash
+                chdir: "{{ nico_repo_path }}"
+              vars:
+                build_target: images-bfb
+                build_refs:
+                  - "boot-artifacts-aarch64:{{ image_tag }}"
+                build_pre: "{{ nico_bfb_pre_clean }}"
+              when: nico_build_bfb | bool
+              register: nico_build_bfb_result
+              changed_when: "'BUILD ' in nico_build_bfb_result.stdout"
+
+        # setup.sh deploys nvmetal-carbide but the Makefile builds nico, so copy it via
+        # pull tag push (imagetools create drops cross repo children on our registry).
+        - name: Publish the core image as nvmetal-carbide (the name setup.sh deploys)
+          ansible.builtin.shell: |
+            set -euo pipefail
+            nc="{{ image_repo }}/nvmetal-carbide:{{ image_tag }}"
+            ni="{{ image_repo }}/nico:{{ image_tag }}"
+            nc_repo="{{ image_repo }}/nvmetal-carbide"
+
+            # Complete means the index and every child digest it lists resolve in
+            # nvmetal-carbide, an existing index alone is not proof the tag pulls.
+            carbide_complete() {
+              local kids kid
+              kids=$(sg docker -c "docker buildx imagetools inspect --raw ${nc}" 2>/dev/null |
+                grep -oE 'sha256:[a-f0-9]{64}' | sort -u) || return 1
+              [ -n "${kids}" ] || return 1
+              for kid in ${kids}; do
+                sg docker -c "docker buildx imagetools inspect --raw ${nc_repo}@${kid}" >/dev/null 2>&1 || return 1
+              done
+            }
+
+            if [ "{{ force_rebuild | bool | ternary('1', '0') }}" != "1" ] && carbide_complete; then
+              echo "SKIP nvmetal-carbide already complete at {{ image_tag }}"
+              exit 0
+            fi
+            # buildx pushes each arch as an index carrying an attestation, so a plain
+            # pull looks for the host platform and misses. Ask for the arch by name.
+            for arch in amd64 arm64; do
+              sg docker -c "docker pull --platform linux/${arch} ${ni}-${arch}"
+              sg docker -c "docker tag ${ni}-${arch} ${nc}-${arch}"
+              sg docker -c "docker push ${nc}-${arch}"
+            done
+            sg docker -c "docker buildx imagetools create -t ${nc} ${nc}-amd64 ${nc}-arm64"
+            if ! carbide_complete; then
+              echo "nvmetal-carbide index at {{ image_tag }} has unresolved children"
+              exit 1
+            fi
+            echo "CREATED nvmetal-carbide"
+          args:
+            executable: /bin/bash
+          become: false
+          when: nico_build_core | bool
+          register: nvmetal_retag
+          changed_when: "'CREATED' in nvmetal_retag.stdout"
+
+        - name: Report the built tag
+          ansible.builtin.debug:
+            msg: >-
+              Images published to {{ image_repo }} at {{ image_tag }}. lab/scripts/env.sh
+              derives the same tag from {{ nico_tag_ref }} by default; export
+              CORE_TAG={{ image_tag }} if you passed a custom image_tag.
diff --git a/lab/ansible/mgmt.yaml b/lab/ansible/mgmt.yaml
new file mode 100644
index 000000000..aef3fc12f
--- /dev/null
+++ b/lab/ansible/mgmt.yaml
@@ -0,0 +1,676 @@
+---
+# Copyright 2026 s3rj1k
+# SPDX-License-Identifier: MIT
+
+# Single node k0s (containerd + Calico) for the lab mgmt VM, run on the node.
+# Control plane also runs workloads. mgmt IPs 10.42.71.102 and 192.168.42.102.
+
+- name: Single-node k0s control plane on the lab mgmt node
+  hosts: localhost
+  connection: local
+  become: true
+  gather_facts: true
+
+  vars:
+    # k0s minor track, the latest matching patch is resolved at run time.
+    k0s_major_minor: "1.35"
+    # API and etcd bind IP, the mgmt primary that Calico can-reach autodetects.
+    api_address: "10.42.71.102"
+    # API off 9443 so BMO's hostNetwork :9443 webhook can bind later.
+    k0s_api_port: 9643
+    # Extra API cert SANs (local net + loopback).
+    api_sans:
+      - "192.168.42.102"
+      - "127.0.0.1"
+      - "localhost"
+    # Reprovision by resetting an existing k0s and reinstalling. false leaves it.
+    k0s_reset_if_present: true
+    # The mgmt host provisioning L2 address. Kea VIP and the relay both have to sit
+    # on this subnet.
+    mgmt_provisioning_ip: "{{ MGMT_SECONDARY_IP | default('192.168.42.102') }}"
+    # Kea VIP that MetalLB assigns, so confirm it after a rebuild. Empty disables
+    # the relay.
+    dhcp_server: "{{ DHCP_SERVER | default('192.168.42.201') }}"
+    dhcp_relay_image: "ghcr.io/mirantis/dhcp-relay:latest"
+    dhcp_relay_image_bin: "/usr/local/bin/dhcp-relay"   # binary path inside the image
+    dhcp_relay_bin: "/usr/local/bin/dhcp-relay"
+    dhcp_relay_extra_args: ""
+    # Gateway address must match the segment gateway nico hands out via DHCP,
+    # see the networks entry in the nico core values.
+    nat_enabled: true
+    nat_wan_iface: "{{ NAT_WAN_IFACE | default('ens3') }}"
+    nat_lan_iface: "{{ NAT_LAN_IFACE | default('ens4') }}"
+    provisioning_gateway_ip: "{{ PROVISIONING_GATEWAY_IP | default('192.168.42.1') }}"
+    provisioning_subnet: "{{ PROVISIONING_SUBNET | default('192.168.42.0/24') }}"
+    # Kea answers a relayed request by sending to giaddr, which is a fresh packet
+    # rather than a tracked reply, so it follows the default route out the uplink.
+    dhcp_reply_route_enabled: true
+    dhcp_reply_lan_iface: "{{ nat_lan_iface }}"
+    dhcp_reply_gateway: "{{ provisioning_gateway_ip }}"
+    # k0s default, the cluster config below sets no podCIDR of its own.
+    dhcp_reply_pod_cidr: "{{ POD_CIDR | default('10.244.0.0/16') }}"
+    # Doubles as the rule preference, so both are visible under one number.
+    dhcp_reply_table: 100
+    # In cluster CoreDNS, the resolver booted machines use. Recurses to WAN, forwards
+    # the NICo zone to nico-dns and is exposed on the mgmt 2nd NIC by externalIPs.
+    coredns_enabled: true
+    coredns_image: "docker.io/coredns/coredns:1.14.6"
+    coredns_external_ip: "{{ mgmt_provisioning_ip }}"
+    # NICo authoritative zone, match nico-api initial_domain_name in nico-core.yaml.
+    coredns_nico_zone: "{{ NICO_ZONE | default('192.168.42.10.sslip.io') }}"
+    # nico-dns ClusterIP, match nico-dns.service.clusterIP in nico-core.yaml.
+    coredns_nico_dns_ip: "{{ NICO_DNS_CLUSTERIP | default('10.96.0.53') }}"
+    # Upstream resolvers for everything else (space-separated).
+    coredns_wan_forward: "{{ WAN_DNS | default('8.8.8.8 1.1.1.1') }}"
+    # Static .forge records (replaces unbound localData), matching the NICo service
+    # VIPs pinned in nico-core.yaml (patch 0014). Each item is "IP name1 name2 ...".
+    coredns_forge_records:
+      - "192.168.42.211 carbide-api.forge nico-api.forge"
+      - "192.168.42.204 carbide-pxe.forge nico-pxe.forge carbide-static-pxe.forge"
+      - "192.168.42.206 carbide-ntp.forge nico-ntp.forge"
+      - "192.168.42.207 carbide-ntp.forge nico-ntp.forge"
+      - "192.168.42.208 carbide-ntp.forge nico-ntp.forge"
+
+  pre_tasks:
+    - name: Assert the host is Debian/Ubuntu on amd64
+      ansible.builtin.assert:
+        that:
+          - ansible_facts.distribution in ["Debian", "Ubuntu"]
+          - ansible_facts.architecture == "x86_64"
+        fail_msg: "mgmt.yaml supports Debian/Ubuntu amd64 only."
+
+    - name: Wait for cloud-init to finish (only when run at first boot)
+      ansible.builtin.wait_for:
+        path: /var/lib/cloud/instance/boot-finished
+        timeout: 600
+      when: lookup('env', 'CLOUD_INIT') | length > 0
+
+  handlers:
+    - name: Restart dhcp-relay
+      ansible.builtin.systemd_service:
+        name: dhcp-relay
+        state: restarted
+        daemon_reload: true
+
+    - name: Restart lab-provisioning-nat
+      ansible.builtin.systemd_service:
+        name: lab-provisioning-nat
+        state: restarted
+        daemon_reload: true
+
+    - name: Restart lab-dhcp-reply-route
+      ansible.builtin.systemd_service:
+        name: lab-dhcp-reply-route
+        state: restarted
+        daemon_reload: true
+
+  tasks:
+    - name: Upgrade all packages
+      ansible.builtin.apt:
+        update_cache: true
+        upgrade: safe
+
+    - name: Install prerequisites
+      ansible.builtin.apt:
+        name:
+          - ca-certificates
+          - curl
+          - jq
+        state: present
+
+    - name: Resolve the latest k0s patch release for series {{ k0s_major_minor }}
+      ansible.builtin.shell:
+        cmd: |
+          set -o pipefail
+          curl -fsSL "https://api.github.com/repos/k0sproject/k0s/releases" \
+            | jq -r '.[] | select(.tag_name | test("^v{{ k0s_major_minor | replace(".", "\\.") }}\\.[0-9]+\\+k0s\\.[0-9]+$")) | .tag_name' \
+            | head -1
+        executable: /bin/bash
+      register: k0s_release
+      changed_when: false
+
+    - name: Ensure a k0s release was found
+      ansible.builtin.assert:
+        that: k0s_release.stdout | length > 0
+        fail_msg: "No k0s {{ k0s_major_minor }} release found via the GitHub API."
+
+    - name: Install the k0s binary {{ k0s_release.stdout }}
+      ansible.builtin.get_url:
+        url: "https://github.com/k0sproject/k0s/releases/download/{{ k0s_release.stdout }}/k0s-{{ k0s_release.stdout }}-amd64"
+        dest: /usr/local/bin/k0s
+        mode: "0755"
+
+    # Tear down any prior k0s first so /etc/k0s below is written after reset,
+    # which wipes cluster state, /var/lib/k0s and the systemd unit.
+    - name: Detect an existing k0s controller
+      ansible.builtin.stat:
+        path: /etc/systemd/system/k0scontroller.service
+      register: k0s_present
+
+    - name: Nuke the existing k0s cluster before reprovisioning
+      when: k0s_present.stat.exists and k0s_reset_if_present
+      block:
+        - name: Stop the running k0s controller
+          ansible.builtin.command: k0s stop
+          changed_when: true
+          failed_when: false
+
+        - name: Reset k0s (wipes cluster state, data and the systemd unit)
+          ansible.builtin.command: k0s reset --kubelet-root-dir=/var/lib/kubelet
+          changed_when: true
+          failed_when: false
+
+    - name: Create the k0s config directory
+      ansible.builtin.file:
+        path: /etc/k0s
+        state: directory
+        mode: "0755"
+
+    - name: Create the k0s containerd drop-in directory
+      ansible.builtin.file:
+        path: /etc/k0s/containerd.d
+        state: directory
+        mode: "0755"
+
+    # Drop compressed blobs after unpack, about half the disk. They re-pull if GC'd.
+    # https://docs.k0sproject.io/head/runtime/
+    - name: Discard unpacked layer blobs to halve per-image disk cost
+      ansible.builtin.copy:
+        dest: /etc/k0s/containerd.d/10-discard-unpacked-layers.toml
+        content: |
+          [plugins."io.containerd.grpc.v1.cri".containerd]
+            discard_unpacked_layers = true
+        mode: "0644"
+
+    - name: Write the k0s cluster config
+      ansible.builtin.copy:
+        dest: /etc/k0s/k0s.yaml
+        mode: "0644"
+        content: |
+          apiVersion: k0s.k0sproject.io/v1beta1
+          kind: ClusterConfig
+          metadata:
+            name: k0s
+            namespace: kube-system
+          spec:
+            api:
+              address: {{ api_address }}
+              k0sApiPort: {{ k0s_api_port }}
+              sans: {{ api_sans | to_json }}
+            telemetry:
+              enabled: false
+            storage:
+              type: etcd
+              etcd:
+                peerAddress: {{ api_address }}
+            network:
+              provider: calico
+              dualStack:
+                enabled: false
+              calico:
+                mode: vxlan
+                mtu: 1400
+                overlay: Always
+                ipAutodetectionMethod: can-reach=8.8.8.8
+                envVars:
+                  FELIX_IGNORELOOSERPF: "true"
+                  FELIX_ALLOWVXLANPACKETSFROMWORKLOADS: "true"
+            featureGates:
+              - name: ImageVolume
+                enabled: true
+            workerProfiles:
+              - name: numa
+                values:
+                  topologyManagerPolicy: "best-effort"
+                  cpuManagerPolicy: "static"
+                  cpuManagerPolicyOptions:
+                    full-pcpus-only: "true"
+                    distribute-cpus-across-numa: "true"
+                  reservedSystemCPUs: "0"
+                  # aggressive image GC so build layers don't accumulate
+                  imageGCHighThresholdPercent: 60
+                  imageGCLowThresholdPercent: 50
+                  imageMinimumGCAge: 1m
+                  # absolute eviction thresholds (percentage defaults too lax here)
+                  evictionHard:
+                    memory.available: "500Mi"
+                    nodefs.available: "5Gi"
+                    imagefs.available: "5Gi"
+                  evictionMinimumReclaim:
+                    memory.available: "0Mi"
+                    nodefs.available: "1Gi"
+                    imagefs.available: "2Gi"
+                  reservedMemory:
+                    - limits:
+                        memory: 2Gi
+                      numaNode: 0
+                  kubeReservedCgroup: ""
+
+    - name: Create the k0scontroller systemd override directory
+      ansible.builtin.file:
+        path: /etc/systemd/system/k0scontroller.service.d
+        state: directory
+        mode: "0755"
+
+    - name: Raise file descriptors and OOM-protect k0scontroller
+      ansible.builtin.copy:
+        dest: /etc/systemd/system/k0scontroller.service.d/override.conf
+        content: |
+          [Service]
+          LimitNOFILE=1048576
+          OOMScoreAdjust=-999
+        mode: "0644"
+
+    - name: Install k0s as a single-node controller+worker
+      ansible.builtin.command:
+        cmd: >-
+          k0s install controller -c /etc/k0s/k0s.yaml
+          --enable-dynamic-config --disable-components=konnectivity-server
+          --enable-worker --no-taints --profile numa
+          --kubelet-root-dir=/var/lib/kubelet --verbose
+      changed_when: true
+      # Fresh node, or we just reset. Skip only when leaving a cluster in place.
+      when: k0s_reset_if_present or not k0s_present.stat.exists
+
+    - name: Start and enable k0scontroller (picks up the drop-in override)
+      ansible.builtin.systemd_service:
+        name: k0scontroller.service
+        state: started
+        enabled: true
+        daemon_reload: true
+
+    - name: Wait for the k0s admin kubeconfig
+      ansible.builtin.wait_for:
+        path: /var/lib/k0s/pki/admin.conf
+        timeout: 300
+
+    # Node Ready implies Calico (auto-deployed by k0s) has rolled out.
+    - name: Wait for the node to become Ready
+      ansible.builtin.command:
+        cmd: k0s kubectl wait --for=condition=Ready nodes --all --timeout=300s
+      environment:
+        KUBECONFIG: /var/lib/k0s/pki/admin.conf
+      register: node_ready
+      changed_when: false
+      until: node_ready.rc == 0
+      retries: 30
+      delay: 30
+
+    # DHCPv4 relay (ghcr.io/mirantis/dhcp-relay) forwards provisioning-L2 DHCP to
+    # NICo's Kea. Binary extracted from the image via docker pull + cp.
+    - name: Install and configure the DHCPv4 relay
+      when: dhcp_server | length > 0
+      block:
+        # A destination off the provisioning L2 is silently swallowed. 172.17.1.201
+        # routed into the docker0 bridge, so relayed packets vanished and Kea saw none.
+        - name: Assert the relay destination sits on the provisioning L2
+          ansible.builtin.assert:
+            that:
+              - dhcp_server.split('.')[0:3] == mgmt_provisioning_ip.split('.')[0:3]
+            fail_msg: >-
+              dhcp_server {{ dhcp_server }} is not on the provisioning L2
+              {{ mgmt_provisioning_ip }}/24. Set DHCP_SERVER to the
+              nico-dhcp-external LoadBalancer VIP, or leave it unset to take the
+              default.
+            success_msg: "relay destination {{ dhcp_server }} is on the provisioning L2"
+
+        - name: Install Docker (used to pull the relay image)
+          ansible.builtin.apt:
+            name: docker.io
+            state: present
+
+        - name: Ensure Docker is running
+          ansible.builtin.systemd_service:
+            name: docker
+            state: started
+            enabled: true
+
+        - name: Pull the dhcp-relay image
+          ansible.builtin.command: "docker pull {{ dhcp_relay_image }}"
+          register: dhcp_relay_pull
+          changed_when: true
+          until: dhcp_relay_pull.rc == 0
+          retries: 5
+          delay: 3
+
+        - name: Extract the relay binary from the image
+          block:
+            - name: Remove any stale extract container
+              ansible.builtin.command: docker rm -f dhcp-relay-extract
+              changed_when: false
+              failed_when: false
+
+            - name: Create a container from the relay image
+              # Image has no entrypoint or cmd, so docker create needs a placeholder.
+              ansible.builtin.command: "docker create --name dhcp-relay-extract {{ dhcp_relay_image }} true"
+              changed_when: true
+
+            - name: Copy the relay binary out of the container
+              ansible.builtin.command: "docker cp dhcp-relay-extract:{{ dhcp_relay_image_bin }} {{ dhcp_relay_bin }}"
+              changed_when: true
+              notify: Restart dhcp-relay
+          always:
+            - name: Remove the extract container
+              ansible.builtin.command: docker rm -f dhcp-relay-extract
+              changed_when: false
+              failed_when: false
+
+        - name: Ensure the relay binary is executable
+          ansible.builtin.file:
+            path: "{{ dhcp_relay_bin }}"
+            mode: "0755"
+
+        - name: Install the dhcp-relay systemd unit
+          ansible.builtin.copy:
+            dest: /etc/systemd/system/dhcp-relay.service
+            mode: "0644"
+            content: |
+              [Unit]
+              Description=DHCPv4 relay to {{ dhcp_server }}
+              After=network-online.target
+              Wants=network-online.target
+
+              [Service]
+              ExecStart={{ dhcp_relay_bin }} -dhcp-server-address {{ dhcp_server }} -log-no-datetime {{ dhcp_relay_extra_args }}
+              Restart=on-failure
+              RestartSec=2
+
+              [Install]
+              WantedBy=multi-user.target
+          notify: Restart dhcp-relay
+
+        - name: Enable and start dhcp-relay
+          ansible.builtin.systemd_service:
+            name: dhcp-relay
+            enabled: true
+            state: started
+            daemon_reload: true
+
+    - name: Note when the DHCP relay is skipped
+      ansible.builtin.debug:
+        msg: "DHCP relay skipped; set DHCP_SERVER to a Kea VIP to install it."
+      when: dhcp_server | length == 0
+
+    # Nothing owned the segment gateway address, so provisioned hosts had no
+    # egress and the qcow imager could not pull its OS image.
+    - name: Route and NAT the provisioning subnet
+      when: nat_enabled
+      block:
+        # Builtin only, so write a sysctl file and apply it rather than the posix
+        # sysctl module.
+        - name: Persist IPv4 forwarding
+          ansible.builtin.copy:
+            dest: /etc/sysctl.d/99-lab-provisioning-nat.conf
+            mode: "0644"
+            content: |
+              net.ipv4.ip_forward = 1
+
+        - name: Apply IPv4 forwarding
+          ansible.builtin.command: sysctl --system
+          changed_when: false
+
+        # A /32 alias avoids a duplicate route for a subnet already covered.
+        - name: Install the provisioning gateway and NAT rules
+          ansible.builtin.copy:
+            dest: /usr/local/sbin/lab-provisioning-nat
+            mode: "0755"
+            content: |
+              #!/bin/bash
+              # Idempotent, safe to rerun on every boot.
+              set -euo pipefail
+              ip addr show {{ nat_lan_iface }} | grep -q 'inet {{ provisioning_gateway_ip }}/32' \
+                || ip addr add {{ provisioning_gateway_ip }}/32 dev {{ nat_lan_iface }}
+              iptables -t nat -C POSTROUTING -s {{ provisioning_subnet }} -o {{ nat_wan_iface }} -j MASQUERADE 2>/dev/null \
+                || iptables -t nat -A POSTROUTING -s {{ provisioning_subnet }} -o {{ nat_wan_iface }} -j MASQUERADE
+              iptables -C FORWARD -i {{ nat_lan_iface }} -o {{ nat_wan_iface }} -j ACCEPT 2>/dev/null \
+                || iptables -I FORWARD 1 -i {{ nat_lan_iface }} -o {{ nat_wan_iface }} -j ACCEPT
+              iptables -C FORWARD -i {{ nat_wan_iface }} -o {{ nat_lan_iface }} -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
+                || iptables -I FORWARD 2 -i {{ nat_wan_iface }} -o {{ nat_lan_iface }} -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
+          notify: Restart lab-provisioning-nat
+
+        # Oneshot rather than the persistent iptables package so the address and
+        # rules reapply together.
+        - name: Install the provisioning NAT unit
+          ansible.builtin.copy:
+            dest: /etc/systemd/system/lab-provisioning-nat.service
+            mode: "0644"
+            content: |
+              [Unit]
+              Description=Gateway address and NAT for the provisioning subnet
+              After=network-online.target
+              Wants=network-online.target
+
+              [Service]
+              Type=oneshot
+              RemainAfterExit=true
+              ExecStart=/usr/local/sbin/lab-provisioning-nat
+
+              [Install]
+              WantedBy=multi-user.target
+          notify: Restart lab-provisioning-nat
+
+        - name: Enable and start the provisioning NAT unit
+          ansible.builtin.systemd_service:
+            name: lab-provisioning-nat
+            enabled: true
+            state: started
+            daemon_reload: true
+
+    # Without this the reply leaves by the default route on the uplink and the relay
+    # never sees it, so the host retries discovery until it gives up and boots disk.
+    - name: Route DHCP replies out the provisioning NIC
+      when: dhcp_reply_route_enabled
+      block:
+        - name: Install the DHCP reply routing script
+          ansible.builtin.copy:
+            dest: /usr/local/sbin/lab-dhcp-reply-route
+            mode: "0755"
+            content: |
+              #!/bin/bash
+              # Idempotent, safe to rerun on every boot.
+              set -euo pipefail
+              ip rule show | grep -qF "{{ dhcp_reply_pod_cidr }} ipproto udp dport 67" \
+                || ip rule add from {{ dhcp_reply_pod_cidr }} ipproto udp dport 67 \
+                   lookup {{ dhcp_reply_table }} pref {{ dhcp_reply_table }}
+              ip route replace default via {{ dhcp_reply_gateway }} \
+                dev {{ dhcp_reply_lan_iface }} table {{ dhcp_reply_table }}
+          notify: Restart lab-dhcp-reply-route
+
+        # Oneshot for the same reason as the NAT unit, the rule and the route have
+        # to reapply together after a reboot.
+        - name: Install the DHCP reply routing unit
+          ansible.builtin.copy:
+            dest: /etc/systemd/system/lab-dhcp-reply-route.service
+            mode: "0644"
+            content: |
+              [Unit]
+              Description=Policy route for DHCP replies out {{ dhcp_reply_lan_iface }}
+              After=network-online.target
+              Wants=network-online.target
+
+              [Service]
+              Type=oneshot
+              RemainAfterExit=true
+              ExecStart=/usr/local/sbin/lab-dhcp-reply-route
+
+              [Install]
+              WantedBy=multi-user.target
+          notify: Restart lab-dhcp-reply-route
+
+        - name: Enable and start the DHCP reply routing unit
+          ansible.builtin.systemd_service:
+            name: lab-dhcp-reply-route
+            enabled: true
+            state: started
+            daemon_reload: true
+
+        # The source port half is handled by externalTrafficPolicy Local on
+        # nico-dhcp-external, applied by lab patch 0016.
+        - name: Show the resulting rule and routing table
+          ansible.builtin.shell:
+            cmd: |
+              set -o pipefail
+              ip rule show | grep 'dport 67' || true
+              ip route show table {{ dhcp_reply_table }}
+            executable: /bin/bash
+          register: dhcp_reply_state
+          changed_when: false
+
+        - name: Report the DHCP reply route
+          ansible.builtin.debug:
+            var: dhcp_reply_state.stdout_lines
+
+    # In cluster CoreDNS resolver for booted machines, forwarding the NICo zone to
+    # nico-dns on the mgmt 2nd NIC so nico-dhcp can hand it out as the nameserver.
+    - name: Deploy the in-cluster CoreDNS resolver
+      when: coredns_enabled
+      environment:
+        KUBECONFIG: /var/lib/k0s/pki/admin.conf
+      block:
+        - name: Create the CoreDNS config directory
+          ansible.builtin.file:
+            path: /etc/coredns
+            state: directory
+            mode: "0755"
+
+        - name: Write the CoreDNS Corefile
+          ansible.builtin.copy:
+            dest: /etc/coredns/Corefile
+            mode: "0644"
+            content: |
+              {% if coredns_nico_zone | length > 0 %}
+              {{ coredns_nico_zone }}:53 {
+                  errors
+                  forward . {{ coredns_nico_dns_ip }}
+                  cache 30
+              }
+              {% endif %}
+              {% if coredns_forge_records | length > 0 %}
+              forge:53 nico:53 {
+                  errors
+                  hosts {
+              {% for rec in coredns_forge_records %}
+                      {{ rec }}
+              {% endfor %}
+                      ttl 60
+                      fallthrough
+                  }
+              }
+              {% endif %}
+              unknowndomain:53 {
+                  template ANY ANY {
+                      rcode NXDOMAIN
+                  }
+              }
+              .:53 {
+                  errors
+                  health {
+                      lameduck 5s
+                  }
+                  ready
+                  forward . {{ coredns_wan_forward }}
+                  cache 30
+                  loop
+                  reload
+              }
+
+        - name: Write the CoreDNS Deployment and Service manifest
+          ansible.builtin.copy:
+            dest: /etc/coredns/lab-coredns.yaml
+            mode: "0644"
+            content: |
+              apiVersion: apps/v1
+              kind: Deployment
+              metadata:
+                name: coredns
+                namespace: lab-dns
+                labels:
+                  app: coredns
+              spec:
+                replicas: 1
+                selector:
+                  matchLabels:
+                    app: coredns
+                template:
+                  metadata:
+                    labels:
+                      app: coredns
+                  spec:
+                    containers:
+                      - name: coredns
+                        image: {{ coredns_image }}
+                        args: ["-conf", "/etc/coredns/Corefile"]
+                        ports:
+                          - containerPort: 53
+                            protocol: UDP
+                            name: dns
+                          - containerPort: 53
+                            protocol: TCP
+                            name: dns-tcp
+                        livenessProbe:
+                          httpGet:
+                            path: /health
+                            port: 8080
+                          initialDelaySeconds: 10
+                          periodSeconds: 10
+                        readinessProbe:
+                          httpGet:
+                            path: /ready
+                            port: 8181
+                          initialDelaySeconds: 5
+                          periodSeconds: 10
+                        resources:
+                          requests:
+                            cpu: 50m
+                            memory: 64Mi
+                          limits:
+                            memory: 170Mi
+                        volumeMounts:
+                          - name: config
+                            mountPath: /etc/coredns
+                            readOnly: true
+                    volumes:
+                      - name: config
+                        configMap:
+                          name: coredns
+                          items:
+                            - key: Corefile
+                              path: Corefile
+              ---
+              apiVersion: v1
+              kind: Service
+              metadata:
+                name: coredns
+                namespace: lab-dns
+                labels:
+                  app: coredns
+              spec:
+                type: ClusterIP
+                externalIPs:
+                  - {{ coredns_external_ip }}
+                selector:
+                  app: coredns
+                ports:
+                  - name: dns
+                    port: 53
+                    protocol: UDP
+                    targetPort: 53
+                  - name: dns-tcp
+                    port: 53
+                    protocol: TCP
+                    targetPort: 53
+
+        - name: Apply the CoreDNS namespace, config, and workload
+          ansible.builtin.shell:
+            cmd: |
+              set -o pipefail
+              k0s kubectl get namespace lab-dns >/dev/null 2>&1 || k0s kubectl create namespace lab-dns
+              k0s kubectl create configmap coredns -n lab-dns \
+                --from-file=Corefile=/etc/coredns/Corefile \
+                --dry-run=client -o yaml | k0s kubectl apply -f -
+              k0s kubectl apply -f /etc/coredns/lab-coredns.yaml
+            executable: /bin/bash
+          register: coredns_apply
+          changed_when: "'created' in coredns_apply.stdout or 'configured' in coredns_apply.stdout"
+
+    # Post-k0s mgmt setup goes below (KUBECONFIG=/var/lib/k0s/pki/admin.conf).
diff --git a/lab/ansible/worker.yaml b/lab/ansible/worker.yaml
new file mode 100644
index 000000000..49710babe
--- /dev/null
+++ b/lab/ansible/worker.yaml
@@ -0,0 +1,452 @@
+---
+# Copyright 2026 s3rj1k
+# SPDX-License-Identifier: MIT
+
+# Libvirt/KVM + stock sushy-tools (Redfish) for the lab worker VM, the box that
+# hosts the emulated bare-metal machines NICo provisions. Run on the node.
+
+# The emulated VMs attach directly to the worker's 2nd NIC via macvtap (no host
+# bridge, no dnsmasq, no NAT here). Set PROVISIONING_NIC to that interface.
+
+- name: Libvirt hypervisor + sushy-tools on the lab worker node
+  hosts: localhost
+  connection: local
+  become: true
+  gather_facts: true
+
+  vars:
+    # 2nd NIC the emulated VMs attach to directly via macvtap. Override if not ens4.
+    provisioning_nic: "{{ PROVISIONING_NIC | default('ens4') }}"
+    provisioning_network: default   # libvirt network name the VMs attach to
+    # stock sushy-tools from PyPI (not the s3rj1k fork)
+    sushy_tools_pip: "{{ SUSHY_TOOLS_PIP | default('sushy-tools') }}"
+    redfish_port: 8000
+    # Recreate emulated VMs each run, dropping all domains then creating vm_count.
+    vm_recreate: "{{ VM_RECREATE | default(true) }}"
+    vm_count: "{{ VM_COUNT | default(1) }}"
+
+  pre_tasks:
+    - name: Assert the host is Debian/Ubuntu on amd64
+      ansible.builtin.assert:
+        that:
+          - ansible_facts.distribution in ["Debian", "Ubuntu"]
+          - ansible_facts.architecture == "x86_64"
+        fail_msg: "worker.yaml supports Debian/Ubuntu amd64 only."
+
+    - name: Wait for cloud-init to finish (only when run at first boot)
+      ansible.builtin.wait_for:
+        path: /var/lib/cloud/instance/boot-finished
+        timeout: 600
+      when: lookup('env', 'CLOUD_INIT') | length > 0
+
+  handlers:
+    - name: Restart libvirtd
+      ansible.builtin.systemd_service:
+        name: libvirtd
+        state: restarted
+        daemon_reload: true
+
+    - name: Restart sushy-emulator
+      ansible.builtin.systemd_service:
+        name: sushy-emulator
+        state: restarted
+        daemon_reload: true
+
+  tasks:
+    - name: Upgrade all packages
+      ansible.builtin.apt:
+        update_cache: true
+        upgrade: safe
+
+    - name: Install libvirt/KVM hypervisor packages
+      ansible.builtin.apt:
+        name:
+          - libguestfs-tools
+          - libosinfo-bin
+          - libvirt-clients
+          - libvirt-daemon-system
+          - ovmf
+          - qemu-kvm
+          - virtinst
+        state: present
+
+    - name: Load required kernel modules
+      ansible.builtin.command: "modprobe {{ item }}"
+      loop:
+        - kvm
+        - kvm_intel
+        - kvm_amd
+      changed_when: false
+      failed_when: false
+
+    - name: Persist required kernel modules
+      ansible.builtin.copy:
+        dest: /etc/modules-load.d/95-local.conf
+        content: |
+          kvm
+          kvm_intel
+          kvm_amd
+        mode: "0644"
+
+    - name: Configure libvirt QEMU (no security driver, run as root)
+      ansible.builtin.copy:
+        dest: /etc/libvirt/qemu.conf
+        content: |
+          security_driver = "none"
+          user = "root"
+          group = "root"
+          dynamic_ownership = 0
+        mode: "0644"
+      notify: Restart libvirtd
+
+    - name: Enable and start libvirtd
+      ansible.builtin.systemd_service:
+        name: libvirtd
+        enabled: true
+        state: started
+
+    - name: Configure the default libvirt storage pool
+      block:
+        - name: Check whether the default storage pool exists
+          ansible.builtin.command: virsh pool-info default
+          register: default_pool
+          changed_when: false
+          failed_when: false
+
+        - name: Check whether a legacy 'images' pool exists
+          ansible.builtin.command: virsh pool-info images
+          register: images_pool
+          changed_when: false
+          failed_when: false
+          when: default_pool.rc != 0
+
+        - name: Retire the legacy 'images' pool
+          ansible.builtin.command: "virsh {{ item }} images"
+          loop:
+            - pool-destroy
+            - pool-undefine
+          failed_when: false
+          changed_when: true
+          when:
+            - default_pool.rc != 0
+            - images_pool.rc == 0
+
+        - name: Create the default storage pool directory
+          ansible.builtin.file:
+            path: /var/lib/libvirt/images
+            state: directory
+            mode: "0755"
+          when: default_pool.rc != 0
+
+        - name: Define, build, start and autostart the default pool
+          ansible.builtin.command: "{{ item }}"
+          loop:
+            - virsh pool-define-as default dir --target /var/lib/libvirt/images
+            - virsh pool-build default
+            - virsh pool-start default
+            - virsh pool-autostart default
+          changed_when: true
+          failed_when: false
+          when: default_pool.rc != 0
+
+    - name: Configure the provisioning network (macvtap direct to the 2nd NIC)
+      block:
+        - name: Inspect the current provisioning network definition
+          ansible.builtin.command: "virsh net-dumpxml {{ provisioning_network }}"
+          register: prov_net
+          changed_when: false
+          failed_when: false
+
+        - name: Rebuild the provisioning network when missing or misconfigured
+          # Rebuild if it still has an <ip> (a NAT/dnsmasq net) or lacks our NIC.
+          when: >-
+            prov_net.rc != 0
+            or '<ip ' in prov_net.stdout
+            or provisioning_nic not in prov_net.stdout
+          block:
+            - name: Tear down the existing provisioning network
+              ansible.builtin.command: "virsh {{ item }} {{ provisioning_network }}"
+              loop:
+                - net-destroy
+                - net-undefine
+              failed_when: false
+              changed_when: true
+
+            - name: Write the provisioning network XML (macvtap direct)
+              ansible.builtin.copy:
+                dest: "/root/{{ provisioning_network }}-network.xml"
+                mode: "0644"
+                content: |
+                  <network>
+                    <name>{{ provisioning_network }}</name>
+                    <forward mode='bridge'>
+                      <interface dev='{{ provisioning_nic }}'/>
+                    </forward>
+                  </network>
+
+            - name: Define the provisioning network
+              ansible.builtin.command: "virsh net-define /root/{{ provisioning_network }}-network.xml"
+              changed_when: true
+
+        - name: Start the provisioning network
+          ansible.builtin.command: "virsh net-start {{ provisioning_network }}"
+          register: net_start
+          changed_when: "'started' in net_start.stdout"
+          failed_when:
+            - net_start.rc != 0
+            - "'already active' not in net_start.stderr"
+
+        - name: Autostart the provisioning network
+          ansible.builtin.command: "virsh net-autostart {{ provisioning_network }}"
+          changed_when: true
+
+    - name: Apply queued libvirtd changes before starting sushy-tools
+      ansible.builtin.meta: flush_handlers
+
+    # sushy-tools (stock, PyPI) Redfish BMC emulator over libvirt.
+    - name: Install sushy-tools build/runtime dependencies
+      ansible.builtin.apt:
+        name:
+          - apache2-utils   # htpasswd
+          - build-essential
+          - libvirt-dev     # to build libvirt-python in the venv
+          - openssl
+          - pkg-config
+          - python3-dev
+          - python3-pip
+          - python3-venv
+        state: present
+
+    - name: Check for an existing Redfish password
+      ansible.builtin.stat:
+        path: /root/.redfish_password
+      register: redfish_password_file
+
+    - name: Read the existing Redfish password
+      ansible.builtin.slurp:
+        src: /root/.redfish_password
+      register: existing_redfish_password
+      when: redfish_password_file.stat.exists
+
+    - name: Reuse the existing Redfish password
+      ansible.builtin.set_fact:
+        redfish_password: "{{ existing_redfish_password.content | b64decode | trim }}"
+      when: redfish_password_file.stat.exists
+
+    - name: Generate a new Redfish password
+      ansible.builtin.set_fact:
+        redfish_password: "{{ lookup('ansible.builtin.password', '/dev/null', chars=['ascii_letters', 'digits'], length=16) }}"
+      when: not redfish_password_file.stat.exists
+
+    - name: Create the sushy-tools directory structure
+      ansible.builtin.file:
+        path: "{{ item }}"
+        state: directory
+        mode: "0755"
+      loop:
+        - /opt/sushy-tools
+        - /etc/sushy
+        - /etc/sushy/ssl
+
+    - name: Create the sushy-tools virtualenv
+      ansible.builtin.command:
+        cmd: python3 -m venv /opt/sushy-tools/venv
+        creates: /opt/sushy-tools/venv/bin/python
+
+    - name: Install libvirt-python into the venv
+      ansible.builtin.pip:
+        name: libvirt-python
+        virtualenv: /opt/sushy-tools/venv
+
+    - name: Install stock sushy-tools into the venv
+      ansible.builtin.pip:
+        name: "{{ sushy_tools_pip }}"
+        virtualenv: /opt/sushy-tools/venv
+      notify: Restart sushy-emulator
+
+    - name: Generate the sushy-tools TLS private key
+      ansible.builtin.command:
+        cmd: openssl genrsa -out /etc/sushy/sushy.key 2048
+        creates: /etc/sushy/sushy.key
+
+    - name: Generate the sushy-tools self-signed certificate
+      ansible.builtin.command:
+        cmd: >-
+          openssl req -new -x509 -key /etc/sushy/sushy.key
+          -out /etc/sushy/sushy.cert -days 365
+          -subj "/C=US/ST=State/L=City/O=Organization/CN=localhost"
+        creates: /etc/sushy/sushy.cert
+
+    - name: Lock down the TLS files
+      ansible.builtin.file:
+        path: "{{ item }}"
+        owner: root
+        group: root
+        mode: "0600"
+      loop:
+        - /etc/sushy/sushy.key
+        - /etc/sushy/sushy.cert
+
+    - name: Create the Redfish htpasswd file
+      ansible.builtin.command:
+        cmd: "htpasswd -cbB /etc/sushy/htpasswd admin {{ redfish_password }}"
+      changed_when: true
+      notify: Restart sushy-emulator
+
+    - name: Lock down the htpasswd file
+      ansible.builtin.file:
+        path: /etc/sushy/htpasswd
+        owner: root
+        group: root
+        mode: "0600"
+
+    - name: Persist the Redfish password
+      ansible.builtin.copy:
+        content: "{{ redfish_password }}"
+        dest: /root/.redfish_password
+        mode: "0600"
+        owner: root
+        group: root
+
+    - name: Write the sushy-tools configuration (stock options only)
+      ansible.builtin.copy:
+        dest: /etc/sushy/sushy-emulator.conf
+        mode: "0644"
+        content: |
+          SUSHY_EMULATOR_LISTEN_IP = '0.0.0.0'
+          SUSHY_EMULATOR_LISTEN_PORT = {{ redfish_port }}
+          SUSHY_EMULATOR_OS_CLOUD = None
+          SUSHY_EMULATOR_LIBVIRT_URI = 'qemu:///system'
+          SUSHY_EMULATOR_IGNORE_BOOT_DEVICE = False
+          SUSHY_EMULATOR_FEATURE_SET = 'full'
+          SUSHY_EMULATOR_AUTH_FILE = '/etc/sushy/htpasswd'
+          SUSHY_EMULATOR_SSL_CERT = '/etc/sushy/sushy.cert'
+          SUSHY_EMULATOR_SSL_KEY = '/etc/sushy/sushy.key'
+          SUSHY_EMULATOR_BOOT_LOADER_MAP = {
+              'UEFI': {'x86_64': '/usr/share/OVMF/OVMF_CODE.fd'},
+              'Legacy': {'x86_64': None},
+          }
+          SUSHY_EMULATOR_VMEDIA_DEVICES = {
+              'Cd': {'Name': 'Virtual CD', 'MediaTypes': ['CD', 'DVD']},
+          }
+          SUSHY_EMULATOR_VMEDIA_VERIFY_SSL = False
+      notify: Restart sushy-emulator
+
+    - name: Write the sushy-emulator start script
+      ansible.builtin.copy:
+        dest: /opt/sushy-tools/sushy-emulator.sh
+        mode: "0755"
+        content: |
+          #!/bin/bash
+          set -eu -o pipefail
+          # shellcheck source=/dev/null
+          source /opt/sushy-tools/venv/bin/activate
+          exec /opt/sushy-tools/venv/bin/sushy-emulator \
+              --config /etc/sushy/sushy-emulator.conf
+
+    - name: Install the sushy-emulator systemd unit
+      ansible.builtin.copy:
+        dest: /etc/systemd/system/sushy-emulator.service
+        mode: "0644"
+        content: |
+          [Unit]
+          Description=Sushy Tools Redfish Emulator
+          Documentation=https://docs.openstack.org/sushy-tools/
+          After=network.target libvirtd.service
+          Requires=libvirtd.service
+
+          [Service]
+          Type=simple
+          User=root
+          Group=root
+          WorkingDirectory=/opt/sushy-tools
+          ExecStart=/opt/sushy-tools/sushy-emulator.sh
+          Restart=always
+          RestartSec=10
+          TimeoutStartSec=60
+          TimeoutStopSec=30
+          Environment=PYTHONUNBUFFERED=1
+          NoNewPrivileges=true
+          PrivateTmp=true
+          ProtectSystem=strict
+          ProtectHome=true
+          ReadWritePaths=/opt/sushy-tools /var/lib/libvirt /run/libvirt
+
+          [Install]
+          WantedBy=multi-user.target
+      notify: Restart sushy-emulator
+
+    - name: Enable and start sushy-emulator
+      ansible.builtin.systemd_service:
+        name: sushy-emulator
+        enabled: true
+        state: started
+        daemon_reload: true
+
+    # Recreate the emulated bare metal VMs, dropping every domain then creating a
+    # fresh set. Blank UEFI disks on the macvtap net that NICo powers and PXE boots.
+    - name: Install the create-vm helper
+      ansible.builtin.copy:
+        dest: /usr/local/bin/create-vm
+        mode: "0755"
+        content: |
+          #!/usr/bin/env bash
+          set -euo pipefail
+
+          if [[ $# -ne 2 ]]; then
+              echo "Usage: $0 NODE_INDEX NETWORK_NAME" >&2
+              echo "Example: $0 1 default" >&2
+              exit 1
+          fi
+
+          NODE_INDEX="$1"
+          NETWORK_NAME="$2"
+          if ! [[ "$NODE_INDEX" =~ ^[0-9]+$ ]]; then
+              echo "Error: NODE_INDEX must be a number" >&2
+              exit 1
+          fi
+
+          VM_NAME="node${NODE_INDEX}"
+          DISK_PATH="/var/lib/libvirt/images/${VM_NAME}-disk.qcow2"
+          DISK_SERIAL="node-disk-$(printf "%03d" "$NODE_INDEX")"
+          MAC_ADDRESS="52:54:00:12:34:$(printf "%02x" "$NODE_INDEX")"
+
+          # /run is a share of RAM and the scout loader stages scout.squashfs
+          # there, so too little RAM fails the download.
+          virt-install \
+              --name "$VM_NAME" \
+              --vcpus "6" \
+              --ram "14336" \
+              --os-variant "debian12" \
+              --connect "qemu:///system" \
+              --disk "path=${DISK_PATH},bus=virtio,size=60,format=qcow2,discard=unmap,serial=${DISK_SERIAL}" \
+              --disk "device=cdrom,bus=sata" \
+              --network "network=${NETWORK_NAME},mac=${MAC_ADDRESS}" \
+              --console "pty,target.type=virtio" \
+              --serial "pty" \
+              --graphics "vnc,listen=0.0.0.0" \
+              --import \
+              --noautoconsole \
+              --noreboot \
+              --boot "uefi,firmware.feature0.name=enrolled-keys,firmware.feature0.enabled=no,firmware.feature1.name=secure-boot,firmware.feature1.enabled=yes"
+
+    - name: Drop all existing VMs
+      ansible.builtin.shell: |
+        for d in $(virsh list --all --name); do
+          virsh destroy "$d" 2>/dev/null || true
+          virsh undefine "$d" --nvram --remove-all-storage 2>/dev/null || true
+        done
+      changed_when: true
+      when: vm_recreate | bool
+
+    - name: Create the emulated VMs (node1..nodeN)
+      ansible.builtin.command: "/usr/local/bin/create-vm {{ item }} {{ provisioning_network }}"
+      loop: "{{ range(1, (vm_count | int) + 1) | list }}"
+      changed_when: true
+      when: vm_recreate | bool
+
+    - name: Show the Redfish endpoint and credentials
+      ansible.builtin.debug:
+        msg:
+          - "Redfish API: https://<worker-ip>:{{ redfish_port }}/redfish/v1/"
+          - "Username: admin (password in /root/.redfish_password)"
