index 000000000..0100fa68d
--- /dev/null
+++ b/lab/scripts/provision-instance.sh
@@ -0,0 +1,447 @@
+#!/usr/bin/env bash
+# Provisions a dpuless machine. Registers the OS image, reuses the live instance or
+# allocates one onto the flat VPC, then reboots with custom pxe to image the disk.
+# Rerunning only reimages. Recycling or reenrolling a machine is register.sh.
+set -euo pipefail
+
+LAB_ENV="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lab.env"
+[[ -f "$LAB_ENV" ]] || {
+  echo "ERROR: ${LAB_ENV} missing; run env.sh to generate it." >&2
+  exit 1
+}
+# shellcheck disable=SC1090
+source "$LAB_ENV"
+
+NS=nico-system
+API_PORT=1079
+API_DEPLOY=deploy/nico-api
+
+# Ack string for cloud unsafe ops.
+CLOUD_UNSAFE_OP="${CLOUD_UNSAFE_OP:-devenv}"
+
+# pin a machine, empty means first Ready one
+MACHINE_ID="${MACHINE_ID:-}"
+TENANT_ORG="${TENANT_ORG:-devenv_test_org}"
+# Flat VPC to allocate into, created by register.sh. The API assigns its id, so it
+# is resolved by name below and an empty FLAT_VPC_ID means resolve FLAT_VPC_NAME.
+FLAT_VPC_NAME="${FLAT_VPC_NAME:-devenv_flat_vpc}"
+FLAT_VPC_ID="${FLAT_VPC_ID:-}"
+# used only when OS_IMAGE_URL is empty, no double quotes
+IPXE_SCRIPT="${IPXE_SCRIPT:-chain --autofree https://boot.netboot.xyz}"
+# Debian generic, not genericcloud, and debian only. An ubuntu cloud image ships a
+# virtual kernel with no linux modules extra, so it has no driver for the boot nic.
+OS_IMAGE_BUILD="${OS_IMAGE_BUILD:-20260810-2566}"
+# Dated build, never latest. Upstream rebuilds latest in place, which moves the digest
+# and the root fs uuid out from under an already registered os_image, both silently.
+OS_IMAGE_URL="${OS_IMAGE_URL-https://cloud.debian.org/images/cloud/trixie/${OS_IMAGE_BUILD}/debian-13-generic-amd64-${OS_IMAGE_BUILD}.qcow2}"
+# digest, empty reads SHA512SUMS next to the url
+OS_IMAGE_SHA="${OS_IMAGE_SHA:-}"
+# preregistered os_image uuid, derived from url when empty
+OS_IMAGE_ID="${OS_IMAGE_ID:-}"
+# The debian image labels no filesystem, so the imager finds root by uuid and quietly
+# skips the seed when that resolves to nothing. A run probes the image and overrides.
+OS_IMAGE_ROOTFS_UUID="${OS_IMAGE_ROOTFS_UUID-6d1bd696-738f-4565-8c0c-b1b51bc7c3d7}"
+# The sushy VM boots a single virtio disk, and the imager only autodetects
+# nvme0n1/sda, so pin it rather than relying on find_bootdisk.
+OS_IMAGE_BOOT_DISK="${OS_IMAGE_BOOT_DISK-/dev/vda}"
+# The image ships no sshd host keys and cc_ssh does not always generate them, so
+# bootcmd does it early and idempotently before sshd starts.
+
+# The user is created here instead of inherited from the image default, so the keys
+# have to live in the user block. Top level keys only reach a default marked user.
+# The password is for the serial console only and ssh stays key only. The drop in
+# sorts ahead of the cloud init one because sshd keeps the first value it reads.
+DEFAULT_USER_DATA=$(cat <<'YAML'
+#cloud-config
+ssh_pwauth: false
+ssh_deletekeys: false
+disable_root: true
+users:
+  - name: debian
+    gecos: Debian
+    shell: /bin/bash
+    lock_passwd: false
+    groups: [adm, sudo]
+    sudo: 'ALL=(ALL) NOPASSWD:ALL'
+    ssh_authorized_keys:
+      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKLrIiGjB4nPsyKzgzY21asVi/HKlveRnNY77vOhRhOA
+      - ecdsa-sha2-nistp384 AAAAE2VjZHNhLXNoYTItbmlzdHAzODQAAAAIbmlzdHAzODQAAABhBCPagTtscBi9vEGuH7BgFoURfrDRaC73gyOPdadub8sjUPsLjkMDrEKfVcALtQGLjY8KLr+BusayRYLDcZmgSayjKEgrKAFxJcu8YAfOYC+rptOyWs9uEERLf5RcXJV4Mw==
+bootcmd:
+  - [ sh, -c, "ssh-keygen -A || true" ]
+runcmd:
+  - [ sh, -c, "echo 'debian:debian' | chpasswd" ]
+  - [ sh, -c, "install -d -m 0755 /etc/ssh/sshd_config.d" ]
+  - [ sh, -c, "echo 'PermitRootLogin no' > /etc/ssh/sshd_config.d/00-forge.conf" ]
+  - [ sh, -c, "echo 'PasswordAuthentication no' >> /etc/ssh/sshd_config.d/00-forge.conf" ]
+  - [ sh, -c, "echo 'KbdInteractiveAuthentication no' >> /etc/ssh/sshd_config.d/00-forge.conf" ]
+  - [ sh, -c, "systemctl enable ssh || true" ]
+  - [ sh, -c, "systemctl restart ssh || true" ]
+  - [ sh, -c, "date -u +%Y-%m-%dT%H:%M:%SZ > /nico-provisioned-at" ]
+YAML
+)
+USER_DATA="${USER_DATA-$DEFAULT_USER_DATA}"
+# Only used when there is no instance yet and one has to be allocated.
+READY_TIMEOUT="${READY_TIMEOUT:-900}"
+# Covers imaging plus the reboots after it.
+PROVISION_TIMEOUT="${PROVISION_TIMEOUT:-1800}"
+# How long the host gets to start the install, it has to POST and netboot first.
+LEAVE_TIMEOUT="${LEAVE_TIMEOUT:-600}"
+# How long a freshly allocated machine gets to settle into assigned/ready.
+SETTLE_TIMEOUT="${SETTLE_TIMEOUT:-600}"
+
+if [[ -n "$OS_IMAGE_URL" && -z "$OS_IMAGE_ID" ]]; then # stable id per url => idempotent re-runs
+  OS_IMAGE_ID=$(python3 -c 'import sys,uuid; print(uuid.uuid5(uuid.NAMESPACE_URL, sys.argv[1]))' "$OS_IMAGE_URL")
+fi
+
+# Builds the OS config JSON for instance allocate. OS_IMAGE_ID does a disk
+# install, otherwise an inline iPXE live boot. OS_JSON overrides it.
+if [[ -z "${OS_JSON:-}" ]]; then
+  if [[ -n "$OS_IMAGE_ID" ]]; then
+    OS_JSON=$(printf \
+      '{"variant":{"OsImageId":{"value":"%s"}},"phone_home_enabled":false,"run_provisioning_instructions_on_every_boot":false}' \
+      "$OS_IMAGE_ID")
+  else
+    OS_JSON=$(printf \
+      '{"variant":{"Ipxe":{"ipxe_script":"%s"}},"phone_home_enabled":false,"run_provisioning_instructions_on_every_boot":true}' \
+      "$IPXE_SCRIPT")
+  fi
+  if [[ -n "$USER_DATA" ]]; then
+    OS_JSON=$(printf '%s' "$OS_JSON" | python3 -c \
+      'import sys,json; d=json.load(sys.stdin); d["user_data"]=sys.argv[1]; print(json.dumps(d))' "$USER_DATA")
+  fi
+fi
+
+admin() {
+  # admin cli reads API_URL / ROOT_CA_PATH / CLIENT_CERT_PATH / CLIENT_KEY_PATH.
+  kubectl -n "$NS" exec -i "$API_DEPLOY" -- env \
+    API_URL="https://nico-api.${NS}.svc.cluster.local:${API_PORT}" \
+    ROOT_CA_PATH=/var/run/secrets/forge-roots/ca.crt \
+    CLIENT_CERT_PATH=/var/run/secrets/spiffe.io/tls.crt \
+    CLIENT_KEY_PATH=/var/run/secrets/spiffe.io/tls.key \
+    /opt/carbide/nico-admin-cli "$@"
+}
+
+jqa() { # admin cli json through a jq filter, empty on any failure
+  admin -f json "${@:2}" 2>/dev/null | jq -r "$1" 2>/dev/null || true
+}
+
+machine_state() { # composite state as the api reports it, e.g. assigned/ready
+  jqa ".machines[] | select(.id == \"$1\") | .state | ascii_downcase" machine show
+}
+
+image_rootfs_uuid() {
+  # Prints the ext4 root uuid of a remote qcow2, empty when it cannot be read. The
+  # image is not downloaded, qemu-io asks for byte ranges, about 2 MiB per probe.
+  local url="$1" opts hdr entries entry sb uuid count size start i
+  [[ "$url" == *://* ]] && command -v qemu-io >/dev/null 2>&1 || return 1
+  opts="driver=qcow2,file.driver=${url%%://*},file.url=$url"
+
+  qio() { # hex of a byte range, 16 byte columns per line, ascii column dropped
+    qemu-io -r --image-opts "$opts" -c "read -v $1 $2" 2>/dev/null |
+      awk '$1 ~ /^[0-9a-f]{8,}:$/ && NF >= 17 { for (i = 2; i <= 17; i++) printf "%s", $i }'
+  }
+  le() { # little endian field at hex offset $2, $3 hex digits long, as decimal
+    local hex="${1:$2:$3}" out="" i
+    for ((i = ${#hex}; i > 0; i -= 2)); do out+="${hex:i-2:2}"; done
+    printf '%d' "0x$out"
+  }
+
+  hdr=$(qio 512 512)                                       # GPT header, lba 1
+  [[ "${hdr:0:16}" == "4546492050415254" ]] || return 1    # "EFI PART"
+  count=$(le "$hdr" 160 8)                                 # entry count, 0x50
+  size=$(le "$hdr" 168 8)                                  # entry size, 0x54
+  ((count > 0 && size >= 128)) || return 1
+  entries=$(qio 1024 $((count * size < 16384 ? count * size : 16384)))
+
+  # Debian ships the root as the one ext4 partition, next to BIOS boot and the ESP.
+  for ((i = 0; i < count; i++)); do
+    entry="${entries:i*size*2:size*2}"
+    ((${#entry} == size * 2)) || break
+    [[ "${entry:0:32}" == "00000000000000000000000000000000" ]] && continue
+    start=$(le "$entry" 64 16)                             # first lba, 0x20
+    sb=$(qio $((start * 512 + 1024)) 1024)                 # ext superblock, 1 KiB in
+    [[ "${sb:112:4}" == "53ef" ]] || continue              # s_magic 0xef53, 0x38
+    uuid="${sb:208:32}"                                    # s_uuid, 0x68
+    printf '%s-%s-%s-%s-%s\n' "${uuid:0:8}" "${uuid:8:4}" "${uuid:12:4}" \
+      "${uuid:16:4}" "${uuid:20:12}"
+    return 0
+  done
+  return 1
+}
+
+echo "[1/4] looking for a live instance..."
+# Reusing the instance is the common path. Allocating is only for a fresh machine,
+# and releasing is deliberately not done here because it triggers the full scrub.
+INSTANCE_ID=""
+if [[ -n "$MACHINE_ID" ]]; then
+  INSTANCE_ID=$(jqa ".instances[] | select(.machine_id == \"$MACHINE_ID\") | .id" instance show | head -1)
+else
+  # Not read from a process substitution, an empty list gives it EOF, which returns
+  # non zero and set -e then kills the script with no output at all.
+  pair=$(jqa '.instances[] | "\(.id) \(.machine_id)"' instance show | head -1)
+  if [[ -n "$pair" ]]; then
+    read -r INSTANCE_ID MACHINE_ID <<<"$pair"
+  fi
+fi
+REUSED=false
+if [[ -n "$INSTANCE_ID" ]]; then
+  REUSED=true
+  echo "  reusing instance $INSTANCE_ID on machine $MACHINE_ID"
+else
+  echo "  (none, will allocate)"
+fi
+
+echo "[2/4] ensuring OS image..."
+if [[ -n "$OS_IMAGE_URL" ]]; then
+  if probed=$(image_rootfs_uuid "$OS_IMAGE_URL"); then
+    if [[ "$probed" != "$OS_IMAGE_ROOTFS_UUID" ]]; then
+      echo "  root uuid ${OS_IMAGE_ROOTFS_UUID:-<unset>} -> $probed, read from the image"
+      OS_IMAGE_ROOTFS_UUID="$probed"
+    fi
+  else
+    echo "  WARNING: could not read the root uuid from ${OS_IMAGE_URL##*/}. This needs" >&2
+    echo "  qemu-io from qemu-utils plus its curl module, which debian splits out into" >&2
+    echo "  qemu-block-extra. Falling back to ${OS_IMAGE_ROOTFS_UUID:-<unset>}." >&2
+  fi
+
+  have=$(jqa ".[] | select(.attributes.id.value == \"$OS_IMAGE_ID\")
+    | [.attributes.rootfs_id // \"\", .attributes.boot_disk // \"\"] | @tsv" os-image show)
+  if [[ -n "$have" ]]; then
+    IFS=$'\t' read -r have_uuid have_disk <<<"$have"
+    echo "  $OS_IMAGE_ID already registered"
+    # Neither is settable after create, so both are ignored from the second run on. A
+    # wrong rootfs uuid is the quiet one, the imager never mounts root and drops the seed.
+    for got_want in "rootfs_uuid:$have_uuid:$OS_IMAGE_ROOTFS_UUID" "boot_disk:$have_disk:$OS_IMAGE_BOOT_DISK"; do
+      IFS=: read -r field got want <<<"$got_want"
+      [[ "$got" == "$want" ]] && continue
+      echo "  WARNING: registered $field is '${got:-<unset>}' but this run wants '${want:-<unset>}'." >&2
+      echo "  os-image update cannot change it, delete and recreate the image:" >&2
+      echo "  $(dirname "$0")/admin-cli.sh os-image delete -i $OS_IMAGE_ID -t $TENANT_ORG" >&2
+    done
+  else
+    if [[ -z "$OS_IMAGE_SHA" ]]; then
+      # Debian publishes SHA512SUMS only, the imager picks the hash by digest length.
+      OS_IMAGE_SHA=$(curl -sfL --max-time 60 "${OS_IMAGE_URL%/*}/SHA512SUMS" |
+        awk -v f="${OS_IMAGE_URL##*/}" '$2 == f || $2 == ("*" f) {print $1; exit}' || true)
+      [[ -n "$OS_IMAGE_SHA" ]] || {
+        echo "ERROR: no OS_IMAGE_SHA and no SHA512SUMS next to ${OS_IMAGE_URL##*/}." >&2
+        exit 1
+      }
+    fi
+    create_args=(-i "$OS_IMAGE_ID" -u "$OS_IMAGE_URL" -m "$OS_IMAGE_SHA" -t "$TENANT_ORG"
+      -n "${OS_IMAGE_URL##*/}")
+    [[ -n "$OS_IMAGE_ROOTFS_UUID" ]] && create_args+=(-f "$OS_IMAGE_ROOTFS_UUID")
+    [[ -n "$OS_IMAGE_BOOT_DISK" ]] && create_args+=(-b "$OS_IMAGE_BOOT_DISK")
+    admin os-image create "${create_args[@]}"
+    echo "  registered $OS_IMAGE_ID (${OS_IMAGE_URL##*/}, sha ${OS_IMAGE_SHA:0:12}…)"
+  fi
+elif [[ -n "$OS_IMAGE_ID" ]]; then
+  [[ -n "$(jqa ".[] | select(.attributes.id.value == \"$OS_IMAGE_ID\") | .attributes.id.value" os-image show)" ]] || {
+    echo "ERROR: os_image $OS_IMAGE_ID not registered (set OS_IMAGE_URL to register it)." >&2
+    exit 1
+  }
+else
+  echo "  (inline iPXE — skipped)"
+fi
+
+if [[ -z "$INSTANCE_ID" ]]; then
+echo "[3/4] waiting up to ${READY_TIMEOUT}s for a Ready machine..."
+FOUND=""
+for ((t = 0; t < READY_TIMEOUT; t += 10)); do
+  if [[ -n "$MACHINE_ID" ]]; then
+    [[ "$(machine_state "$MACHINE_ID")" == "ready" ]] && FOUND="$MACHINE_ID"
+  else
+    # Any Ready machine that no live instance already claims.
+    claimed=$(jqa '.instances[].machine_id' instance show)
+    for cand in $(jqa '.machines[] | select(.state == "Ready") | .id' machine show); do
+      grep -qxF "$cand" <<<"$claimed" || { FOUND="$cand"; break; }
+    done
+  fi
+  [[ -n "$FOUND" ]] && break
+  st_now=$(jqa '.machines[0].state' machine show)
+  if [[ -n "$st_now" && "$st_now" != "${prev_st:-}" ]]; then
+    echo "  state: $st_now"
+    prev_st="$st_now"
+  fi
+  sleep 10
+done
+if [[ -z "$FOUND" ]]; then
+  echo "ERROR: no Ready machine within ${READY_TIMEOUT}s." >&2
+  echo "Run register.sh first, or watch discovery with:" >&2
+  echo "  $(dirname "$0")/admin-cli.sh machine show" >&2
+  exit 1
+fi
+MACHINE_ID="$FOUND"
+echo "  machine $MACHINE_ID is Ready"
+
+# The VPC id is API-assigned (register.sh created it), so resolve it by name.
+if [[ -z "$FLAT_VPC_ID" ]]; then
+  FLAT_VPC_ID=$(admin -f json vpc show --name "$FLAT_VPC_NAME" 2>/dev/null |
+    jq -r '(.vpcs // [])[0].id | (.value? // .) // empty')
+fi
+[[ -n "$FLAT_VPC_ID" ]] || {
+  echo "ERROR: no ${FLAT_VPC_NAME} VPC found; run register.sh first." >&2
+  exit 1
+}
+
+echo "[4/4] allocating zero-DPU instance '${BMH_NAME}_0' (flat_vpc=$FLAT_VPC_ID, os=${OS_IMAGE_ID:-inline-ipxe})..."
+# Allocates onto the flat VPC with auto networking (the dpuless HostInband
+# path). The instance is named "${BMH_NAME}_0" and the org comes from the VPC.
+alloc_out=$(admin --cloud-unsafe-op "$CLOUD_UNSAFE_OP" instance allocate \
+  --machine-id "$MACHINE_ID" \
+  --flat-vpc-id "$FLAT_VPC_ID" \
+  --prefix-name "$BMH_NAME" \
+  --os "$OS_JSON" 2>&1) || true
+printf '%s\n' "$alloc_out"
+
+INSTANCE_ID=$(jqa ".instances[] | select(.machine_id == \"$MACHINE_ID\") | .id" instance show | head -1)
+if [[ -z "$INSTANCE_ID" ]]; then
+  echo "ERROR: no instance appeared for machine $MACHINE_ID — allocate failed (see output above)." >&2
+  if grep -q 'found unknown segments' <<<"$alloc_out"; then
+    cat >&2 <<HINT
+
+"found unknown segments" means this machine has more than one host nic on the same
+network segment. Allocate makes one instance interface per nic but looks the segments up
+with an IN query, so two nics on one segment count as one segment against two interfaces
+and it refuses. Nothing is actually missing. List them with:
+
+  $(dirname "$0")/admin-cli.sh machine-interfaces show
+
+Every Data row sharing a segment with the primary has to go. machine-interfaces delete
+refuses while a machine is attached, so the extra row is removed in the database, address
+row first. The lasting fix is to stop the second port netbooting so it never registers.
+HINT
+  fi
+  exit 1
+fi
+echo "  instance $INSTANCE_ID created"
+fi
+
+# A reused instance still carries the os config it was allocated with, so changing the
+# image or the user data here would otherwise reimage with the old one.
+if [[ "$REUSED" == "true" ]]; then
+  echo "applying current OS config to the existing instance..."
+  admin --cloud-unsafe-op "$CLOUD_UNSAFE_OP" instance update-os \
+    --instance "$INSTANCE_ID" --os "$OS_JSON"
+fi
+
+# A freshly allocated machine is still walking Ready to PreAssignedMeasuring to
+# Assigned, so settle first or the leave check below passes on the first poll.
+echo "waiting up to ${SETTLE_TIMEOUT}s for assigned/ready before requesting the install..."
+settled=""
+for ((t = 0; t < SETTLE_TIMEOUT; t += 10)); do
+  st=$(machine_state "$MACHINE_ID")
+  if [[ "$st" == "assigned/ready" ]]; then
+    settled=1
+    break
+  fi
+  if [[ -n "$st" && "$st" != "${prev_settle:-}" ]]; then
+    echo "  state: $st"
+    prev_settle="$st"
+  fi
+  sleep 10
+done
+if [[ -z "$settled" ]]; then
+  echo "ERROR: machine did not reach assigned/ready within ${SETTLE_TIMEOUT}s (last: ${st:-unknown})." >&2
+  exit 1
+fi
+
+# Allocation alone leaves the machine at assigned/ready serving exit instructions, so
+# the OS install only runs on a boot requested with custom pxe, which is all a rerun needs.
+
+# The instance user_data is only served while the machine is Assigned/Ready and the
+# imager fetches its seed mid install, so the boot override is what that path reads.
+if [[ -n "$USER_DATA" ]]; then
+  # Every host nic, not just the primary. The override is keyed on the interface and
+  # the api picks it from the source ip, so the other port would find no override.
+  mapfile -t BOOT_IFACES < <(jqa ".machines[] | select(.id == \"$MACHINE_ID\") | .interfaces[] | select(.is_bmc == false) | .id" machine show)
+  # jqa hides every failure, so an empty list can also mean the filter stopped matching.
+  # Provisioning on into the discovery template wastes a full install, so stop here.
+  if ((${#BOOT_IFACES[@]} == 0)) || [[ -z "${BOOT_IFACES[0]}" ]]; then
+    echo "ERROR: no non-BMC interface found for machine $MACHINE_ID, refusing to image." >&2
+    echo "Without an override the imager seeds the discovery template, not USER_DATA. Check:" >&2
+    echo "  $0 is filtering on .is_bmc == false, confirm that field is still emitted" >&2
+    echo "  kubectl -n $NS exec $API_DEPLOY -- /opt/carbide/nico-admin-cli -f json machine show" >&2
+    exit 1
+  fi
+  # The cli reads user data from a file and runs inside the api pod, so stage it there.
+  UD_PATH=/tmp/forge-user-data.yaml
+  printf '%s' "$USER_DATA" | kubectl -n "$NS" exec -i "$API_DEPLOY" -- sh -c "cat > $UD_PATH"
+  # A slice of the payload, enough to prove the override really carries it back.
+  UD_PROBE=$(printf '%s' "$USER_DATA" | awk 'NF && $0 !~ /^#/ {print substr($0, 1, 24); exit}')
+  [[ -n "$UD_PROBE" ]] || {
+    echo "ERROR: USER_DATA has no payload line to verify the boot override against." >&2
+    exit 1
+  }
+  for iface in "${BOOT_IFACES[@]}"; do
+    [[ -z "$iface" ]] && continue
+    echo "seeding user-data via boot override on interface $iface..."
+    admin boot-override set "$iface" -u "$UD_PATH" >/dev/null
+    # set exits 0 even when nothing lands, and the cli logs the readback through
+    # tracing, so fold stderr in before matching.
+    if ! admin boot-override get "$iface" 2>&1 | grep -qF -- "$UD_PROBE"; then
+      echo "ERROR: boot override on interface $iface came back without the user-data." >&2
+      echo "  kubectl -n $NS exec $API_DEPLOY -- /opt/carbide/nico-admin-cli boot-override get $iface" >&2
+      exit 1
+    fi
+    echo "  override verified on $iface"
+  done
+  kubectl -n "$NS" exec "$API_DEPLOY" -- rm -f "$UD_PATH" >/dev/null 2>&1 || true
+fi
+
+echo "requesting custom-pxe reboot to run the OS install..."
+admin --cloud-unsafe-op "$CLOUD_UNSAFE_OP" instance reboot \
+  --instance "$INSTANCE_ID" --custom-pxe
+
+# On a rerun the machine is already assigned/ready, so waiting for that state alone
+# matches on the first poll. Wait for it to leave first, that is the install starting.
+echo "waiting for the host to leave assigned/ready (install starting)..."
+for ((t = 0; t < LEAVE_TIMEOUT; t += 10)); do
+  [[ "$(machine_state "$MACHINE_ID")" != "assigned/ready" ]] && break
+  sleep 10
+done
+if [[ "$(machine_state "$MACHINE_ID")" == "assigned/ready" ]]; then
+  echo "ERROR: host never left assigned/ready within ${LEAVE_TIMEOUT}s, the install did not start." >&2
+  echo "NICo is likely serving exit instructions; check the pxe log for a qcow-imager fetch:" >&2
+  echo "  kubectl -n $NS logs deploy/nico-pxe --since=10m | grep qcow-imager" >&2
+  exit 1
+fi
+
+echo "waiting up to ${PROVISION_TIMEOUT}s for assigned/ready (Redfish power-cycle + iPXE boot)..."
+echo "  (watch the boot live: ssh $(id -un)@${BMC_IP} sudo virsh console ${BMC_REDFISH_ID})"
+prev=""
+state=""
+for ((t = 0; t < PROVISION_TIMEOUT; t += 10)); do
+  state=$(machine_state "$MACHINE_ID" || true)
+  if [[ -n "$state" && "$state" != "$prev" ]]; then
+    echo "  state: $state"
+    prev="$state"
+  fi
+  [[ "$state" == "assigned/ready" ]] && break
+  sleep 10
+done
+if [[ "$state" != "assigned/ready" ]]; then
+  echo "ERROR: machine did not reach assigned/ready within ${PROVISION_TIMEOUT}s (last: ${state:-unknown})." >&2
+  echo "Debug:" >&2
+  echo "  kubectl -n $NS logs $API_DEPLOY --since=10m | grep -iE 'instance|power|ipxe|rune_vendor'" >&2
+  exit 1
+fi
+
+ADDRESSES=$(jqa ".machines[] | select(.id == \"$MACHINE_ID\") | .interfaces[] | select(.is_bmc == false) | .address[]?" machine show | paste -sd, -)
+
+cat <<EOF
+
+Done. Instance ${BMH_NAME}_0 is provisioned:
+
+  instance:  $INSTANCE_ID
+  machine:   $MACHINE_ID
+  addresses: ${ADDRESSES:-<none allocated>}
+
+Inspect / follow up:
+
+  $(basename "$0"): rerun to reimage the same instance
+  register.sh:  reenroll the machine from scratch
+  nico-admin-cli:  instance show $INSTANCE_ID
+  console:    ssh $(id -un)@${BMC_IP} sudo virsh console ${BMC_REDFISH_ID}
+  api logs:   kubectl -n $NS logs $API_DEPLOY --since=5m | grep -iE 'instance|power|ipxe|rune_vendor'
+EOF
diff --git a/lab/scripts/register.md b/lab/scripts/register.md
new file mode 100644
index 000000000..d75cb2ff6
--- /dev/null
+++ b/lab/scripts/register.md
@@ -0,0 +1,108 @@
+# register.sh
+
+Registers a dpuless VM as an ExpectedMachine so site explorer ingests it, and
+builds the flat VPC and HostInband segment it lands on.
+
+Destructive and rerunnable. It drops every registered machine first, including
+any holding a live instance, so this is the reenroll path. Reimaging is
+`provision-instance.sh`.
+
+Needs `lab.env` from `env.sh`, local `kubectl`, `jq`, `python3`, `curl` and `tar`,
+a kube context able to exec into `deploy/nico-api`, and a reachable
+`nico-pg-cluster-0` in the `postgres` namespace. Aborts if `BMC_MAC` equals
+`BOOT_MAC`.
+
+## Steps
+
+Numbers match the `[n/8]` markers the script prints. Two unnumbered `[+]` phases
+run between steps 1 and 2.
+
+0. **Unseal Vault.** Idempotent, a non-zero exit is ignored since the pod may
+   already be ready.
+
+1. **Refresh nico-api.** Merge-patches the `nico-api-vendor-override` ConfigMap
+   from the working tree, both the `*.rn` scripts under
+   `helm/charts/nico-api/files/vendor-override` and
+   `nico-api.vendorOverride.overrides` from `helm-prereqs/values/nico-core.yaml`.
+   Helm renders that ConfigMap at install time, so a rollout alone would keep
+   serving the installed copy. A merge patch never prunes, so a script deleted
+   from the tree keeps being served. Skipped silently if the directory or the
+   ConfigMap is absent, and if `nico-core.yaml` cannot be read or parsed, PyYAML
+   included, it warns and syncs only the scripts. Then sets
+   `imagePullPolicy=Always`, restarts, and waits for pods Ready plus the dhcp and
+   pxe endpoints. Only nico-api is rolled by default, because rolling dhcp, pxe
+   and dns takes the provisioning path down under a booting host.
+
+   Then `[+]` waits up to 60s for admin calls to work and aborts if they never
+   do, and `[+]` sets a 24h `rune_vendor=debug` log filter.
+
+2. **Drop registered machines.** Reads ids straight from the database and
+   force-deletes each with its interfaces, BMC interfaces, credentials and any
+   live instance. A failed delete parks the machine in forcedeletion where the
+   state controller ignores it, so each delete is verified against the table, up
+   to 3 attempts 5s apart before aborting. psql errors are discarded, so a
+   database that cannot be reached makes this step silently do nothing.
+
+3. **Wipe expected machines.** `expected-machine erase`, then truncates
+   `explored_endpoints` and `machine_interfaces`.
+
+4. **Seed credentials.** Site-wide-root BMC, plus DPU and host UEFI, all with
+   `BMC_PASSWORD`. The BMC credential is seeded for user `root`, hardcoded, not
+   `BMC_USERNAME`. These are write once and cannot be reset, so an empty password
+   aborts and an existing seed is treated as a noop.
+
+5. **BMC proxy.** Sets `bmc-proxy` to `:BMC_PORT` when the port is not 443, which
+   is how the sushy emulator on 8000 is reached. `BMC_PORT` is never passed to
+   `expected-machine add`, so this cluster-wide setting is what carries it.
+
+6. **Enable create-machines.**
+
+7. **Flat VPC and HostInband segment.** Resolves a subdomain, aborting if none
+   exists, then adopts the VPC by name, keeping the oldest and pruning duplicates
+   over gRPC because the CLI has no vpc delete. A failed prune only warns. The
+   segment is adopted only on a full field match, so changing `HOST_PREFIX`,
+   `HOST_GW`, `SEG_MTU` or `RESERVE_FIRST` forces a rebuild. Otherwise it deletes
+   conflicting live segments, skipping UNDERLAY so the anchor site explorer needs
+   for the BMC survives, then retries create every 15s until the deleted prefix
+   finishes draining. Only a `prefix overlaps` error is retried, anything else
+   aborts at once. Either way it then waits up to 120s for the segment to report
+   ready, and warns and continues regardless.
+
+8. **Register the ExpectedMachine.** Deletes any existing row for `BMC_MAC`
+   first, `add` has no upsert. Then adds BMC address and credentials, chassis
+   serial, `no-dpu`, lockdown disabled, and one host NIC built from `BOOT_MAC`
+   and `HOST_IP` as primary.
+
+Ends by printing the site-explorer log filter and a machine watch command, then
+`exec`s `provision-instance.sh` if `ALLOCATE_INSTANCE=true`.
+
+## Inputs
+
+Read from `lab.env`: `BMC_MAC`, `BOOT_MAC`, `BMC_IP`, `BMC_PORT`, `BMC_USERNAME`,
+`BMC_PASSWORD`, `SERIAL`, `BMH_NAME`, `HOST_IP`, plus the `KUBECONFIG` it exports.
+
+| Variable | Default | Purpose |
+|---|---|---|
+| `HOST_PREFIX` | `192.168.42.0/24` | Segment prefix |
+| `HOST_GW` | `192.168.42.1` | Segment gateway |
+| `RESERVE_FIRST` | `220` | Addresses reserved before the pool |
+| `SEG_MTU` | `1500` | Segment MTU |
+| `SEG_NAME` | `devenv_host_inband` | Matches the seeded networks entry, so it adopts rather than duplicates |
+| `FLAT_VPC_NAME` | `devenv_flat_vpc` | VPC adopted or created |
+| `FLAT_VPC_ID` | unset | Set it and step 7 skips the VPC adopt, prune and create block, the segment logic still runs |
+| `ORG_ID` | `devenv_test_org` | Owning org |
+| `SUBDOMAIN_ID` | first domain | HostInband needs one for DHCP |
+| `PREFIX_DRAIN_TIMEOUT` | `480` | Seconds to wait out a draining prefix |
+| `CLOUD_UNSAFE_OP` | `register` | Ack string for the VPC and segment writes |
+| `ROLLOUT_WORKLOADS` | `deployment.apps/nico-api` | Space separated object refs, `all` rolls every Deployment and StatefulSet in the namespace |
+| `ALLOCATE_INSTANCE` | `false` | `true` execs into `provision-instance.sh` |
+
+## Notes
+
+`grpcurl` is installed into the nico-api pod for verbs the CLI lacks, such as
+`DeleteVpc`, and for reads that must include tombstones. It downloads an amd64
+binary from github.com, is ephemeral, and step 7 aborts if it cannot be prepared.
+
+A segment delete only tombstones the row. Its prefix stays allocated until the
+controller drains it, which is why step 7 retries instead of failing. If it times
+out, the script names what still holds the prefix.
diff --git a/lab/scripts/register.sh b/lab/scripts/register.sh
new file mode 100755
index 000000000..c635592af
--- /dev/null
+++ b/lab/scripts/register.sh
@@ -0,0 +1,468 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Registers a dpuless VM as an ExpectedMachine on a flat dev env and seeds its
+# BMC and UEFI creds so site explorer ingests it. Needs lab.env from env.sh.
+
+LAB_ENV="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lab.env"
+[[ -f "$LAB_ENV" ]] || {
+  echo "ERROR: ${LAB_ENV} missing; run env.sh to generate it." >&2
+  exit 1
+}
+# shellcheck disable=SC1090
+source "$LAB_ENV"
+
+if [[ "${BMC_MAC,,}" == "${BOOT_MAC,,}" ]]; then
+  echo "ERROR: BMC_MAC ($BMC_MAC) must differ from BOOT_MAC ($BOOT_MAC)." >&2
+  exit 1
+fi
+
+REPO_DIR="${REPO_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
+NS=nico-system
+API_PORT=1079
+API_DEPLOY=deploy/nico-api
+
+# Ack string for cloud unsafe ops. Lab only, never use against production.
+CLOUD_UNSAFE_OP="${CLOUD_UNSAFE_OP:-register}"
+
+# One flat VPC plus one HostInband segment for the dpuless host. The API assigns
+# the VPC id, so it is resolved by name below (empty FLAT_VPC_ID means resolve).
+HOST_PREFIX="${HOST_PREFIX:-192.168.42.0/24}"
+HOST_GW="${HOST_GW:-192.168.42.1}"
+RESERVE_FIRST="${RESERVE_FIRST:-220}"
+SEG_MTU="${SEG_MTU:-1500}"
+ORG_ID="${ORG_ID:-devenv_test_org}"
+FLAT_VPC_NAME="${FLAT_VPC_NAME:-devenv_flat_vpc}"
+FLAT_VPC_ID="${FLAT_VPC_ID:-}"
+# Empty so the API assigns it. A deleted segment keeps its row until the drain
+# finishes, so a fixed id collides with its own tombstone.
+SEG_ID="${SEG_ID:-}"
+# grpcurl is dropped into the api pod for verbs the admin cli lacks and for reads
+# that must include soft deleted objects.
+GRPCURL_VERSION="${GRPCURL_VERSION:-1.9.3}"
+
+echo "[0/8] unseal vault (idempotent)..."
+bash "$REPO_DIR/helm-prereqs/unseal_vault.sh" >/dev/null 2>&1 ||
+  echo "  (unseal helper returned non-zero; continuing — pod may already be ready)"
+
+# Helm renders this ConfigMap from the chart files and from nico-core.yaml, so a
+# rollout on its own keeps serving whatever was installed. Push both before restarting.
+VENDOR_DIR="${REPO_DIR}/helm/charts/nico-api/files/vendor-override"
+CORE_VALUES="${REPO_DIR}/helm-prereqs/values/nico-core.yaml"
+if [[ -d "$VENDOR_DIR" ]] && kubectl -n "$NS" get cm nico-api-vendor-override >/dev/null 2>&1; then
+  echo "[1/8] syncing nico-api-vendor-override from the working tree..."
+  kubectl -n "$NS" patch cm nico-api-vendor-override --type merge -p "$(
+    python3 - "$VENDOR_DIR" "$CORE_VALUES" <<'EOPY'
+import glob, json, os, sys
+vendor_dir, core_values = sys.argv[1], sys.argv[2]
+# Every .rn in the chart dir, the same set the configmap template globs.
+data = {os.path.basename(p): open(p).read() for p in sorted(glob.glob(f"{vendor_dir}/*.rn"))}
+try:
+    import yaml
+    ov = (yaml.safe_load(open(core_values)).get("nico-api") or {}).get("vendorOverride") or {}
+    if ov.get("overrides") is not None:
+        data["vendor-overrides.json"] = json.dumps(ov["overrides"], indent=4) + "\n"
+except Exception as e:
+    print(f"vendor-overrides.json not synced, {e}", file=sys.stderr)
+print(json.dumps({"data": data}))
+EOPY
+  )" >/dev/null
+fi
+
+# Only nico-api reads the vendor override, so only it needs a restart. Rolling dhcp,
+# pxe and dns too takes the provisioning path down while a host may be booting.
+ROLLOUT_WORKLOADS="${ROLLOUT_WORKLOADS:-deployment.apps/nico-api}"
+if [[ "$ROLLOUT_WORKLOADS" == "all" ]]; then
+  mapfile -t WORKLOADS < <(kubectl -n "$NS" get deploy,statefulset -o name)
+else
+  read -r -a WORKLOADS <<< "$ROLLOUT_WORKLOADS"
+fi
+
+echo "[1/8] refresh ${WORKLOADS[*]} (imagePullPolicy=Always + rollout)..."
+for w in "${WORKLOADS[@]}"; do
+  kubectl -n "$NS" patch "$w" --type=json \
+    -p='[{"op":"replace","path":"/spec/template/spec/containers/0/imagePullPolicy","value":"Always"}]' \
+    >/dev/null
+done
+for w in "${WORKLOADS[@]}"; do kubectl -n "$NS" rollout restart "$w" >/dev/null; done
+for w in "${WORKLOADS[@]}"; do kubectl -n "$NS" rollout status "$w" --timeout=180s; done
+
+# Completed job pods never reach Ready, so only wait on the running ones.
+echo "[1/8] waiting for ${NS} pods to be Ready..."
+kubectl -n "$NS" wait --for=condition=Ready pod --all \
+  --field-selector=status.phase=Running --timeout=300s >/dev/null
+
+# rollout status returns before the LoadBalancer endpoints repopulate, and a host
+# that PXE boots in that gap gets no answer and falls through to disk.
+echo "[1/8] waiting for the dhcp and pxe endpoints..."
+for _svc in nico-dhcp-external nico-pxe-external; do
+  for _i in $(seq 1 60); do
+    [[ -n "$(kubectl -n "$NS" get endpoints "$_svc" \
+      -o jsonpath='{.subsets[*].addresses[*].ip}' 2>/dev/null)" ]] && break
+    sleep 2
+  done
+done
+
+admin() {
+  # admin cli reads API_URL / ROOT_CA_PATH / CLIENT_CERT_PATH / CLIENT_KEY_PATH.
+  kubectl -n "$NS" exec -i "$API_DEPLOY" -- env \
+    API_URL="https://nico-api.${NS}.svc.cluster.local:${API_PORT}" \
+    ROOT_CA_PATH=/var/run/secrets/forge-roots/ca.crt \
+    CLIENT_CERT_PATH=/var/run/secrets/spiffe.io/tls.crt \
+    CLIENT_KEY_PATH=/var/run/secrets/spiffe.io/tls.key \
+    /opt/carbide/nico-admin-cli "$@"
+}
+
+# Tolerate reruns. "already exists" and "Not support to reset" are noops.
+_seed_cred() {
+  local out
+  if out=$(admin "$@" 2>&1); then return 0; fi
+  if printf '%s' "$out" | grep -qE 'already exists|Not support to reset'; then
+    echo "  (already seeded — skipping: $*)"
+    return 0
+  fi
+  printf '%s\n' "$out" >&2
+  return 1
+}
+
+# Tolerate reruns. Fixed ids make create calls return already exists.
+admin_ok() {
+  local out
+  if out=$(admin "$@" 2>&1); then
+    if [[ -n "$out" ]]; then printf '%s\n' "$out"; fi
+    return 0
+  fi
+  if printf '%s' "$out" | grep -qiE 'already exists|alreadyexists|duplicate'; then
+    echo "  (already exists — skipping)"
+    return 0
+  fi
+  printf '%s\n' "$out" >&2
+  return 1
+}
+
+# Installs a static grpcurl into the api pod (ephemeral) so we can call gRPC
+# verbs the admin-cli lacks, like DeleteVpc. Echoes the pod name. Lab dev only.
+ensure_grpcurl_pod() {
+  local pod tmp
+  pod=$(kubectl -n "$NS" get pod -o name 2>/dev/null | sed 's|^pod/||' | grep '^nico-api-' | head -1) || return 1
+  [[ -n "$pod" ]] || return 1
+  if kubectl -n "$NS" exec "$pod" -c nico-api -- grpcurl --version >/dev/null 2>&1; then
+    printf '%s' "$pod"
+    return 0
+  fi
+  echo "  installing grpcurl into ${pod}..." >&2
+  tmp=$(mktemp -d) || return 1
+  if ! curl -fsSL "https://github.com/fullstorydev/grpcurl/releases/download/v${GRPCURL_VERSION}/grpcurl_${GRPCURL_VERSION}_linux_x86_64.tar.gz" | tar -xz -C "$tmp" grpcurl; then
+    rm -rf "$tmp"
+    return 1
+  fi
+  kubectl -n "$NS" cp "${tmp}/grpcurl" "${pod}:/usr/local/bin/grpcurl" -c nico-api >&2 || {
+    rm -rf "$tmp"
+    return 1
+  }
+  kubectl -n "$NS" exec "$pod" -c nico-api -- chmod +x /usr/local/bin/grpcurl >&2 || {
+    rm -rf "$tmp"
+    return 1
+  }
+  rm -rf "$tmp"
+  printf '%s' "$pod"
+}
+
+# UEFI creds are write once and cannot be reset, so wait until nico api
+# actually serves before seeding.
+echo "[+] waiting for nico-api to accept admin calls..."
+for _i in $(seq 1 30); do
+  admin machine show >/dev/null 2>&1 && break
+  [[ "$_i" -eq 30 ]] && {
+    echo "ERROR: nico-api not accepting admin calls after 60s; aborting." >&2
+    exit 1
+  }
+  sleep 2
+done
+
+# runtime log filter that traces every Redfish call nico makes for 24h
+echo "[+] enabling rune_vendor=debug log filter..."
+admin set log-filter --filter "info,rune_vendor=debug" --expiry 24h >/dev/null 2>&1 ||
+  echo "  (log-filter set failed; continuing)"
+
+echo "[2/8] dropping all registered machines..."
+mapfile -t MACHINE_IDS < <(
+  kubectl exec -n postgres nico-pg-cluster-0 -c postgres -- \
+    psql -U postgres -d nico_system_nico -tAc 'SELECT id FROM machines;' 2>/dev/null
+)
+# A failed delete parks the machine in forcedeletion, which the state controller ignores
+# by design. Verify the row is gone rather than trusting the exit code, and stop if not.
+for id in "${MACHINE_IDS[@]}"; do
+  [[ -z "$id" ]] && continue
+  echo "  force-delete $id"
+  still=1
+  for attempt in 1 2 3; do
+    out=$(admin machine force-delete --machine "$id" \
+      --delete-interfaces --delete-bmc-interfaces --delete-bmc-credentials \
+      --allow-delete-with-instance 2>&1) || true
+    still=$(kubectl exec -n postgres nico-pg-cluster-0 -c postgres -- \
+      psql -U postgres -d nico_system_nico -tAc "SELECT 1 FROM machines WHERE id = '$id';" 2>/dev/null)
+    [[ -z "$still" ]] && break
+    echo "    attempt ${attempt} left it in place, retrying"
+    sleep 5
+  done
+  if [[ -n "$still" ]]; then
+    echo "ERROR: $id still present after 3 force-delete attempts." >&2
+    printf '%s\n' "$out" | tail -5 >&2
+    exit 1
+  fi
+done
+
+echo "[3/8] wiping expected_machines + cached explored_endpoints..."
+admin expected-machine erase --confirm >/dev/null 2>&1 ||
+  echo "  (expected_machines already empty; continuing)"
+kubectl exec -n postgres nico-pg-cluster-0 -c postgres -- \
+  psql -U postgres -d nico_system_nico -c \
+  'TRUNCATE explored_endpoints, machine_interfaces RESTART IDENTITY CASCADE;' >/dev/null
+
+echo "[4/8] seeding sitewide BMC + UEFI credentials in Vault..."
+# One shot creds that cannot be reset. A bad seed needs a Vault wipe, so
+# refuse an empty password.
+[[ -n "${BMC_PASSWORD}" ]] || {
+  echo "ERROR: BMC_PASSWORD is empty; refusing to seed." >&2
+  exit 1
+}
+_seed_cred credential add-bmc --kind=site-wide-root --username root --password "$BMC_PASSWORD"
+_seed_cred credential add-uefi --kind=dpu --password="$BMC_PASSWORD"
+_seed_cred credential add-uefi --kind=host --password="$BMC_PASSWORD"
+
+if [[ "$BMC_PORT" != "443" ]]; then
+  echo "[5/8] bmc_proxy = PortOnly($BMC_PORT) (cluster-wide)..."
+  admin set bmc-proxy --enabled true --proxy ":${BMC_PORT}" >/dev/null
+else
+  echo "[5/8] bmc_proxy left as-is (BMC_PORT=443)"
+fi
+
+echo "[6/8] enabling create-machines..."
+admin set create-machines --enable >/dev/null
+
+echo "[7/8] creating Flat-VPC + HostInband segment (admin-cli)..."
+# HostInband segments need a subdomain for DHCP, so default to the first
+# domain. Override with SUBDOMAIN_ID.
+SUBDOMAIN_ID="${SUBDOMAIN_ID:-}"
+if [[ -z "$SUBDOMAIN_ID" ]]; then
+  SUBDOMAIN_ID=$(admin -f json domain show 2>/dev/null |
+    jq -r '(.domains // .)[0].id | (.value? // .)' 2>/dev/null || true)
+fi
+[[ -n "$SUBDOMAIN_ID" && "$SUBDOMAIN_ID" != "null" ]] || {
+  echo "ERROR: no domain found for --subdomain-id (set SUBDOMAIN_ID or create a domain first)." >&2
+  exit 1
+}
+
+# Matches the networks entry nico api seeds from the prereqs values at startup.
+# Same name lets us adopt that segment instead of duplicating it.
+SEG_NAME="${SEG_NAME:-devenv_host_inband}"
+
+# Drain defaults to 5m and rearms while IPs stay allocated, so allow slack.
+PREFIX_DRAIN_TIMEOUT="${PREFIX_DRAIN_TIMEOUT:-480}"
+
+# Reads go through grpcurl because the segment finders do not filter on deleted
+# unlike the VPC lookups, and draining segments still own their prefix.
+GRPC_POD="$(ensure_grpcurl_pod)" || {
+  echo "ERROR: could not prepare grpcurl in the nico-api pod; step 7 needs it." >&2
+  exit 1
+}
+
+grpc() {
+  kubectl -n "$NS" exec "$GRPC_POD" -c nico-api -- grpcurl \
+    --cacert /var/run/secrets/forge-roots/ca.crt \
+    --cert /var/run/secrets/spiffe.io/tls.crt \
+    --key /var/run/secrets/spiffe.io/tls.key \
+    -d "$2" \
+    "nico-api.${NS}.svc.cluster.local:${API_PORT}" "forge.Forge/$1"
+}
+
+# Every segment, tombstones included. grpcurl emits lowerCamelCase field names.
+_segments() {
+  local _ids _n
+  _ids=$(grpc FindNetworkSegmentIds '{}' 2>/dev/null |
+    jq -c '{networkSegmentsIds: (.networkSegmentsIds // [])}') || return 1
+  [[ -n "$_ids" ]] || return 1
+  _n=$(jq '.networkSegmentsIds | length' <<<"$_ids")
+  if [[ "$_n" == "0" ]]; then
+    printf '{"networkSegments":[]}'
+    return 0
+  fi
+  grpc FindNetworkSegmentsByIds "$_ids" 2>/dev/null
+}
+
+# Anything on our prefix, live or draining. Used for progress and error output.
+_prefix_holders() {
+  _segments 2>/dev/null | jq -r --arg p "$HOST_PREFIX" '
+    .networkSegments[]?
+    | select(any(.config.prefixes[]?; .prefix == $p))
+    | "\(.metadata.name) [\(.config.segmentType)] " +
+      (if .deleted == null then "live" else "deleting since \(.deleted)" end)' 2>/dev/null
+}
+
+SEGS="$(_segments)" || {
+  echo "ERROR: could not list network segments over gRPC." >&2
+  exit 1
+}
+
+# Adopt by name rather than recreate. create_initial_networks refuses to seed with
+# two live VPCs of one name, so prune extras and keep the oldest.
+if [[ -z "$FLAT_VPC_ID" ]]; then
+  mapfile -t _live_vpcs < <(admin -f json vpc show --name "$FLAT_VPC_NAME" 2>/dev/null |
+    jq -r '(.vpcs // []) | sort_by(.created)[] | .id | (.value? // .) // empty')
+  if ((${#_live_vpcs[@]} > 0)) && [[ -n "${_live_vpcs[0]}" ]]; then
+    FLAT_VPC_ID="${_live_vpcs[0]}"
+    echo "  adopting existing VPC ${FLAT_VPC_ID}"
+    for _vid in "${_live_vpcs[@]:1}"; do
+      [[ -z "$_vid" ]] && continue
+      # admin cli has no vpc delete verb, so DeleteVpc goes over gRPC. Lab only.
+      if grpc DeleteVpc "{\"id\":{\"value\":\"${_vid}\"}}" >/dev/null 2>&1; then
+        echo "  pruned duplicate VPC ${_vid}"
+      else
+        echo "  (could not prune duplicate VPC ${_vid}; continuing)" >&2
+      fi
+    done
+  else
+    admin_ok --cloud-unsafe-op="$CLOUD_UNSAFE_OP" vpc create \
+      --name "$FLAT_VPC_NAME" \
+      --description "Flat VPC for zero-DPU HostInband" \
+      --org-id "$ORG_ID" \
+      --virtualization-type flat
+    FLAT_VPC_ID=$(admin -f json vpc show --name "$FLAT_VPC_NAME" 2>/dev/null |
+      jq -r '(.vpcs // [])[0].id | (.value? // .) // empty')
+    echo "  created VPC ${FLAT_VPC_ID}"
+  fi
+fi
+[[ -n "$FLAT_VPC_ID" ]] || {
+  echo "ERROR: could not resolve the ${FLAT_VPC_NAME} VPC id." >&2
+  exit 1
+}
+
+# Adopt only on a full field match, so overriding HOST_PREFIX, HOST_GW, SEG_MTU or
+# RESERVE_FIRST still forces a rebuild that matches the seeded defaults.
+SEG_ADOPTED=$(jq -r \
+  --arg n "$SEG_NAME" --arg v "$FLAT_VPC_ID" --arg p "$HOST_PREFIX" --arg g "$HOST_GW" \
+  --argjson m "$SEG_MTU" --argjson r "$RESERVE_FIRST" '
+  .networkSegments[]?
+  | select(.deleted == null)
+  | select(.metadata.name == $n)
+  | select(.config.segmentType == "HOST_INBAND")
+  | select((.config.vpcId.value // "") == $v)
+  | select((.config.mtu // 0) == $m)
+  | select((.config.prefixes | length) == 1)
+  | select(.config.prefixes[0].prefix == $p)
+  | select((.config.prefixes[0].gateway // "") == $g)
+  | select((.config.prefixes[0].reserveFirst // 0) == $r)
+  | .id.value' <<<"$SEGS" 2>/dev/null | head -1)
+
+if [[ -n "$SEG_ADOPTED" ]]; then
+  echo "  adopting existing segment ${SEG_NAME} (${SEG_ADOPTED}), fields already match"
+  SEG_ID="$SEG_ADOPTED"
+else
+  # Delete only real blockers, a live segment on our name or prefix. Leave UNDERLAY
+  # so the static assignment anchor that site explorer needs for the BMC survives.
+  mapfile -t _conflicts < <(jq -r --arg n "$SEG_NAME" --arg p "$HOST_PREFIX" '
+    .networkSegments[]?
+    | select(.deleted == null)
+    | select(.config.segmentType != "UNDERLAY")
+    | select(.metadata.name == $n or any(.config.prefixes[]?; .prefix == $p))
+    | .id.value' <<<"$SEGS" 2>/dev/null)
+  for _seg in "${_conflicts[@]}"; do
+    [[ -z "$_seg" ]] && continue
+    if admin --cloud-unsafe-op="$CLOUD_UNSAFE_OP" network-segment delete --id "$_seg" >/dev/null 2>&1; then
+      echo "  deleted conflicting segment ${_seg}"
+    else
+      echo "  (could not delete segment ${_seg}; continuing)" >&2
+    fi
+  done
+
+  # A delete only tombstones the segment and its prefix stays allocated until the
+  # controller drains it, so retry the create until the prefix overlap clears.
+  _deadline=$((SECONDS + PREFIX_DRAIN_TIMEOUT))
+  while :; do
+    if _out=$(admin --cloud-unsafe-op="$CLOUD_UNSAFE_OP" network-segment create \
+      --name "$SEG_NAME" \
+      ${SEG_ID:+--id "$SEG_ID"} \
+      --vpc-id "$FLAT_VPC_ID" \
+      --subdomain-id "$SUBDOMAIN_ID" \
+      --segment-type host-inband \
+      --mtu "$SEG_MTU" \
+      --prefix "$HOST_PREFIX" \
+      --gateway "$HOST_GW" \
+      --reserve-first "$RESERVE_FIRST" 2>&1); then
+      break
+    fi
+    if ! grep -qi 'prefix overlaps' <<<"$_out"; then
+      printf '%s\n' "$_out" >&2
+      exit 1
+    fi
+    if ((SECONDS >= _deadline)); then
+      echo "ERROR: ${HOST_PREFIX} still held after ${PREFIX_DRAIN_TIMEOUT}s by:" >&2
+      _prefix_holders >&2 || true
+      echo "       raise PREFIX_DRAIN_TIMEOUT, or lower network_segment_drain_time" >&2
+      echo "       under network_segment_state_controller in the nico-api config." >&2
+      exit 1
+    fi
+    echo "  ${HOST_PREFIX} still draining: $(_prefix_holders | tr '\n' ';')"
+    sleep 15
+  done
+
+  SEG_ID=$(_segments | jq -r --arg n "$SEG_NAME" '
+    [.networkSegments[]? | select(.deleted == null) | select(.metadata.name == $n) | .id.value][0] // empty')
+  echo "  created segment ${SEG_NAME} (${SEG_ID:-id unknown})"
+fi
+
+# DHCP leases come from this segment, so wait for ready before step 8 registers a
+# machine that needs an address.
+for _i in $(seq 1 40); do
+  _seg_state=$(_segments | jq -r --arg i "$SEG_ID" '
+    [.networkSegments[]? | select(.id.value == $i) | .status.lifecycle.state][0] // empty' 2>/dev/null)
+  [[ "$_seg_state" == *'"ready"'* ]] && break
+  if [[ "$_i" -eq 40 ]]; then
+    echo "  (segment not ready after 120s: ${_seg_state:-unknown}; continuing)" >&2
+    break
+  fi
+  sleep 3
+done
+
+# `expected-machine add` has no upsert, so a rerun collides with the row already
+# there. Delete by BMC MAC first and treat a miss on the first run as fine.
+if admin expected-machine delete "$BMC_MAC" >/dev/null 2>&1; then
+  echo "[8/8] removed existing ExpectedMachine for $BMC_MAC"
+fi
+
+echo "[8/8] registering ExpectedMachine $BMH_NAME (bmc=$BMC_MAC, boot=$BOOT_MAC @ ${BMC_IP}:${BMC_PORT}, host=$HOST_IP)..."
+HOST_NICS_JSON=$(printf '[{"mac_address":"%s","fixed_ip":"%s","primary":true}]' "$BOOT_MAC" "$HOST_IP")
+add_args=(
+  --bmc-mac-address "$BMC_MAC"
+  --bmc-ip-address "$BMC_IP"
+  --bmc-username "$BMC_USERNAME"
+  --bmc-password "$BMC_PASSWORD"
+  --bmc-retain-credentials true
+  --chassis-serial-number "$SERIAL"
+  --dpu-mode no-dpu
+  --dpf-enabled false
+  --disable-lockdown true
+  --host_nics "$HOST_NICS_JSON"
+  --meta-name "$BMH_NAME"
+  --meta-description "registered by register.sh"
+)
+admin expected-machine add "${add_args[@]}"
+
+cat <<EOF
+
+Done. Watch site-explorer for the next ~60s:
+
+  kubectl -n nico-system logs deploy/nico-api --since=2m \\
+    | grep -E '^level=' \\
+    | grep -iE 'explore_site|${BMC_IP}|created_machines|Unsupported|vendor|skipping BMC'
+
+And the machines:
+
+  watch -n 5 '${REPO_DIR}/lab/scripts/admin-cli.sh machine show'
+EOF
+
+# Optional. Provision an instance once the machine reaches Ready.
+if [[ "${ALLOCATE_INSTANCE:-false}" == "true" ]]; then
+  exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/provision-instance.sh"
+fi
-- 
