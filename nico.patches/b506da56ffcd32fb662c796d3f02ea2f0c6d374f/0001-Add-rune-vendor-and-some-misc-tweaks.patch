diff --git a/crates/api/files/bf.cfg b/crates/api/files/bf.cfg
index 284f9b70d..0195e99e8 100644
--- a/crates/api/files/bf.cfg
+++ b/crates/api/files/bf.cfg
@@ -644,6 +644,30 @@ write_files:
 
         [Install]
         WantedBy=multi-user.target
+  - path: /etc/systemd/system/forge-dpu-mst-init.service
+    permissions: '0644'
+    content: |
+      [Unit]
+      Description=Re-init Mellanox mst nodes once before forge-dpu-agent
+      # mst_pciconf goes stale across the platform power-cycle (flint: "Missing
+      # DPU info"). Run once here, not as a forge-dpu-agent ExecStartPre that
+      # re-runs on every Restart= and bounces the oob NIC mid-operation.
+      Before=network-online.target forge-dpu-agent.service
+
+      [Service]
+      Type=oneshot
+      RemainAfterExit=yes
+      ExecStart=-/usr/bin/mst restart
+
+      [Install]
+      WantedBy=multi-user.target
+  - path: /etc/systemd/system/forge-dpu-agent.service.d/10-mst-init.conf
+    permissions: '0644'
+    content: |
+      # Wait for the one-shot mst re-init; it runs once, no per-restart bounce.
+      [Unit]
+      Wants=forge-dpu-mst-init.service
+      After=forge-dpu-mst-init.service
 {% raw %}
   - path: /etc/systemd/system/kubelet.service.d/10-bf.conf
     permissions: '0644'
@@ -731,6 +755,7 @@ runcmd:
   - [ systemctl, mask, kubelet.service ]
   - [ systemctl, enable, dpf-vrf-routes.service ]
   - [ systemctl, enable, dpf-br-mgmt-routes.service ]
+  - [ systemctl, enable, forge-dpu-mst-init.service ]
   - [ systemctl, enable, kubeadm-join.service ]
   - [ bash, -c, '/opt/forge/runcmds.sh' ]
